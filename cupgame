// CRASH - Avia Masters node engine
function generateCrashRound(){const nodes=[];const usedPos=new Set();const n=6+Math.floor(Math.random()*12);for(let i=0;i<n;i++){let pos;do{pos=Math.floor(5+Math.random()*88);}while(usedPos.has(pos));usedPos.add(pos);const rn=Math.random();let type,value;if(rn<.5){type='MULT';value=1.1+Math.random()*1.4;}else if(rn<.75){type='ADD';value=.5+Math.random()*2;}else{type='ROCKET';value=.5;}nodes.push({pos,type,value});}nodes.sort((a,b)=>a.pos-b.pos);let M=1,Y=50;for(const node of nodes){if(node.type==='MULT')M*=node.value;else if(node.type==='ADD')M+=node.value;else{M*=.5;Y-=25;}if(Y<=0)break;}if(Math.random()<.48&&Y>0){let ex=0;while(Y>0&&ex<4){nodes.push({pos:90+ex*2,type:'ROCKET',value:.5});Y-=25;ex++;}}nodes.sort((a,b)=>a.pos-b.pos);return{nodes,crashAt:Math.max(1.01,parseFloat(M.toFixed(2)))};}
function buildCrash(){return '<div class="crash-chart-inner"><canvas id="crash-canvas" width="700" height="280"></canvas><div class="crash-mult" id="crash-mult">1.00x</div></div>'+(adminMode?'<div id="crash-admin-info" style="text-align:center;font-family:var(--fd);font-size:11px;color:#ff3355;padding:4px 8px;background:#ff335510;border-radius:4px;margin-bottom:5px">ADMIN: target shown here</div>':'')+betRow()+'<div style="display:flex;gap:7px;margin-top:6px"><button class="play-btn" id="crash-go" onclick="startCrash()" style="flex:1">BET &amp; LAUNCH</button><button class="play-btn" id="crash-cashout" onclick="cashoutCrash()" style="flex:1;background:var(--gold);color:#06080b;display:none">CASH OUT</button></div><div class="result-box" id="res"></div>';}
