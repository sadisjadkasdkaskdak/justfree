function drawCoin(progress,side){const c=document.getElementById('coin-canvas');if(!c)return;const ctx=c.getContext('2d');const W=c.width,H=c.height,cx=W/2,cy=H/2;ctx.clearRect(0,0,W,H);const scaleX=Math.abs(Math.cos(progress*Math.PI*6));const phase=Math.floor(progress*6)%2===0;const showHeads=side==='heads'?phase:!phase;ctx.save();ctx.translate(cx,cy);ctx.scale(Math.max(.05,scaleX),1);const g=ctx.createRadialGradient(-15,-15,0,0,0,50);g.addColorStop(0,showHeads?'#ffe44a':'#d0d0d0');g.addColorStop(1,showHeads?'#cc9900':'#888');ctx.beginPath();ctx.arc(0,0,50,0,Math.PI*2);ctx.fillStyle=g;ctx.fill();ctx.strokeStyle=showHeads?'#ffcc00':'#aaa';ctx.lineWidth=3;ctx.stroke();ctx.fillStyle=showHeads?'#886600':'#444';ctx.font='bold 26px serif';ctx.textAlign='center';ctx.textBaseline='middle';ctx.fillText(showHeads?'H':'T',0,0);ctx.restore();}
function doCoinFlip(){const bet=getBet();if(!bet||bet>balance){toast('Invalid bet!');return;}if(!activeBetType){toast('Choose Heads or Tails!');return;}const result=Math.random()<.5?'heads':'tails';let progress=0;const anim=setInterval(()=>{progress+=.035;drawCoin(progress,result);if(progress>=1){clearInterval(anim);drawCoin(1,result);document.getElementById('coin-result-lbl').textContent=result.toUpperCase();const win=activeBetType===result?parseFloat((bet*1.9).toFixed(2)):0;balance-=bet;if(win>0)balance+=win;recordBet('Coin Flip',bet,win>bet?win:0);showResultRaw(win>0?result.toUpperCase()+'! Won '+fmt(win)+'!':result.toUpperCase()+' - wrong call. Lost '+fmt(bet)+'.',win>0);updateBal();}},30);}

