function buyScratch(){const bet=getBet();if(!bet||bet>balance){toast('Invalid bet!');return;}scratchBet=bet;balance-=bet;updateBal();document.getElementById('scratch-btn').disabled=true;const symbols=['💎','💰','🏆','⭐','7','Bar','2x','3x','5x'];const grid=document.getElementById('scratch-grid');grid.innerHTML='';const picks=[];for(let i=0;i<9;i++)picks.push(symbols[Math.floor(Math.random()*symbols.length)]);picks.forEach((sym)=>{const d=document.createElement('div');d.style.cssText='background:#888;border-radius:8px;height:60px;display:flex;align-items:center;justify-content:center;cursor:pointer;font-size:20px;border:2px solid #aaa;position:relative;overflow:hidden';d.innerHTML='<div style="position:absolute;inset:0;background:#999;display:flex;align-items:center;justify-content:center;font-family:var(--fu);font-size:12px;color:#555;font-weight:700">SCRATCH</div>';d.onclick=()=>{if(d.querySelector('div'))d.removeChild(d.querySelector('div'));d.innerHTML=sym;d.style.background='#f5f5f5';checkScratch();};grid.appendChild(d);});grid._picks=picks;}
function checkScratch(){const grid=document.getElementById('scratch-grid');const revealed=[...grid.children].filter(d=>!d.querySelector('div'));if(revealed.length===9){const picks=grid._picks||[];const counts={};picks.forEach(s=>counts[s]=(counts[s]||0)+1);const maxMatch=Math.max(...Object.values(counts));let win=0;if(maxMatch>=3){const mult=maxMatch===3?5:maxMatch===4?20:100;win=parseFloat((scratchBet*mult).toFixed(2));balance+=win;recordBet('Scratch',scratchBet,win);showResultRaw(maxMatch+' matches! Won '+fmt(win)+'!',true);}else{recordBet('Scratch',scratchBet,0);showResultRaw('No match. Lost '+fmt(scratchBet)+'.',false);}document.getElementById('scratch-btn').disabled=false;updateBal();}}

