function doSignup(){const u=document.getElementById('su-user').value.trim(),p=document.getElementById('su-pass').value;if(!u||u.length<3){toast('Username too short');return;}if(!p||p.length<3){toast('Password too short');return;}if(accounts[u]){toast('Username taken');return;}accounts[u]={balance:1000,totalWagered:0,totalWon:0,totalBets:0,winCount:0,biggestWin:0,betHistory:[],vipWeekUsed:false};try{localStorage.setItem('cup_accs3',JSON.stringify(accounts));localStorage.setItem('cup_sess3',JSON.stringify({username:u}));}catch(e){}restoreSession(u);closeAuth();toast('Welcome, '+u+'!');}
