function bjRender(hideDealer){document.getElementById('bj-player').innerHTML=bjPlayer.map(mkCard).join('');if(adminMode&&hideDealer&&bjDealer.length>1){document.getElementById('bj-dealer').innerHTML=mkCard(bjDealer[0])+'<div class="pcard" style="background:linear-gradient(135deg,#1a1a40,#0a0a28);color:#8888ff;border:2px solid #4444aa">'+bjDealer[1].r+'<br><span style="opacity:.3">'+bjDealer[1].s+'</span></div>';}else{document.getElementById('bj-dealer').innerHTML=hideDealer?mkCard(bjDealer[0])+mkCardBack():bjDealer.map(mkCard).join('');}document.getElementById('bj-pscore').textContent='Score: '+hVal(bjPlayer);document.getElementById('bj-dscore').textContent=hideDealer?'Dealer: ?':'Dealer: '+hVal(bjDealer);}
function bjDeal(){bjBetAmt=getBet();if(!bjBetAmt||bjBetAmt>balance){toast('Invalid bet!');return;}let tc=bjBetAmt+Object.keys(bjSideBets).length*(bjBetAmt*.25);if(tc>balance){toast('Not enough for side bets!');return;}balance-=tc;updateBal();bjPlayer=[rCard(),rCard()];bjDealer=[rCard(),rCard()];bjOver=false;bjRender(true);['bj-hit','bj-stand','bj-double','bj-split'].forEach(id=>{const e=document.getElementById(id);if(e)e.disabled=false;});document.getElementById('bj-deal').disabled=true;document.getElementById('res').className='result-box';if(hVal(bjPlayer)===21)setTimeout(bjStand,400);}
function bjSetButtons(on){['bj-hit','bj-stand','bj-double','bj-split'].forEach(id=>{const e=document.getElementById(id);if(e)e.disabled=!on;});document.getElementById('bj-deal').disabled=on;}
function bjHit(){bjPlayer.push(rCard());bjRender(true);if(hVal(bjPlayer)>21)bjResolve();}
function bjDouble(){if(balance<bjBetAmt){toast('Not enough!');return;}balance-=bjBetAmt;bjBetAmt*=2;updateBal();bjPlayer.push(rCard());bjRender(false);bjResolve();}
function bjSplit(){if(bjPlayer.length!==2||cVal(bjPlayer[0].r)!==cVal(bjPlayer[1].r)){toast('Need matching cards!');return;}if(balance<bjBetAmt){toast('Not enough!');return;}balance-=bjBetAmt;updateBal();bjPlayer=[bjPlayer[0],rCard()];bjRender(true);toast('Split!');}
function bjStand(){bjResolve();}
function bjResolve(){bjSetButtons(false);while(hVal(bjDealer)<17)bjDealer.push(rCard());bjRender(false);const pv=hVal(bjPlayer),dv=hVal(bjDealer);let win=0,msg='';if(pv>21)msg='Bust! Lost '+fmt(bjBetAmt)+'.';else if(pv===21&&bjPlayer.length===2){win=bjBetAmt*2.5;msg='Blackjack! Won '+fmt(win);}else if(dv>21||pv>dv){win=bjBetAmt*2;msg='You win! '+pv+' vs '+dv+'. Won '+fmt(win);}else if(pv===dv){win=bjBetAmt;msg='Push - returned '+fmt(win)+'.';}else msg='Dealer wins. '+pv+' vs '+dv+'. Lost '+fmt(bjBetAmt)+'.';let sideWin=0,sideMsg='';if(bjSideBets['perfect-pairs']&&cVal(bjPlayer[0].r)===cVal(bjPlayer[1].r)){const sb=bjBetAmt*.25;if(bjPlayer[0].s===bjPlayer[1].s){sideWin+=sb*25;sideMsg+=' Perfect Pair +'+fmt(sb*25)+'!';}else{sideWin+=sb*5;sideMsg+=' Pair +'+fmt(sb*5)+'!';}}if(bjSideBets['lucky-ladies']&&cVal(bjPlayer[0].r)+cVal(bjPlayer[1].r)===20){const sb=bjBetAmt*.25;if(bjPlayer[0].r==='Q'&&bjPlayer[1].r==='Q'){sideWin+=sb*200;sideMsg+=' LUCKY LADIES +'+fmt(sb*200)+'!';}else{sideWin+=sb*10;sideMsg+=' Total 20 +'+fmt(sb*10)+'!';}}if(bjSideBets['insurance']&&hVal(bjDealer)===21){const sb=bjBetAmt*.25;sideWin+=sb*3;sideMsg+=' Insurance +'+fmt(sb*3)+'!';}if(bjSideBets['21plus3']){const rank=evalHand([bjPlayer[0],bjPlayer[1],bjDealer[0]]);if(rank!=='High Card'){const sb=bjBetAmt*.25;sideWin+=sb*40;sideMsg+=' 21+3 +'+fmt(sb*40)+'!';}}if(sideWin>0)balance+=sideWin;if(win>0)balance+=win;if(sideMsg)msg+=sideMsg;recordBet('Blackjack',bjBetAmt,win>bjBetAmt?win:0);showResultRaw(msg,win>bjBetAmt||sideWin>0);updateBal();}

// POKER
let pokerHole=[],pokerComm=[],pokerPot=0,pokerBetAmt=0,pokerStage='pre';
function buildPoker(){return '<div class="poker-table"><div class="poker-label">COMMUNITY CARDS</div><div class="card-row" id="poker-comm"><div style="color:#2a5a7a;font-size:11px;margin:8px 0">Waiting...</div></div><div class="poker-pot" id="poker-pot">Pot: $0.00</div><div style="height:5px"></div><div class="poker-label">YOUR HOLE CARDS</div><div class="card-row" id="poker-hole"></div></div><div class="poker-stage" id="poker-stage">Pre-flop</div><div class="hand-rank" id="hand-rank"></div><div class="poker-actions"><button class="poker-btn fold" id="pk-fold" onclick="pokerAction(\'fold\')" disabled>Fold</button><button class="poker-btn" id="pk-check" onclick="pokerAction(\'check\')" disabled>Check</button><button class="poker-btn raise" id="pk-raise" onclick="pokerAction(\'raise\')" disabled>Raise x2</button><button class="poker-btn" id="pk-allin" onclick="pokerAction(\'allin\')" disabled style="border-color:var(--red);color:var(--red)">All-In</button></div>'+betRow()+'<button class="play-btn" id="pk-deal" onclick="pokerDeal()">DEAL HAND</button><div class="result-box" id="res"></div>';}
function initPoker(){pokerStage='pre';}
function pkSetButtons(on){['pk-fold','pk-check','pk-raise','pk-allin'].forEach(id=>{const e=document.getElementById(id);if(e)e.disabled=!on;});const d=document.getElementById('pk-deal');if(d)d.disabled=on;}
function pokerDeal(){pokerBetAmt=getBet();if(!pokerBetAmt||pokerBetAmt>balance){toast('Invalid bet!');return;}balance-=pokerBetAmt;pokerPot=pokerBetAmt;updateBal();pokerHole=[rCard(),rCard()];pokerComm=[];pokerStage='flop';document.getElementById('poker-hole').innerHTML=pokerHole.map(mkCard).join('');document.getElementById('poker-comm').innerHTML='<div style="color:#2a5a7a;font-size:11px;margin:8px 0">Pre-flop</div>';document.getElementById('poker-pot').textContent='Pot: '+fmt(pokerPot);document.getElementById('poker-stage').textContent='PRE-FLOP';document.getElementById('hand-rank').textContent='';document.getElementById('res').className='result-box';pkSetButtons(true);showHandRank();}
function showHandRank(){const all=[...pokerHole,...pokerComm];if(all.length>=2)document.getElementById('hand-rank').textContent=evalHand(all);}
function pokerAction(action){if(action==='fold'){pkSetButtons(false);showResultRaw('Folded. Lost '+fmt(pokerBetAmt)+'.',false);recordBet('Poker',pokerBetAmt,0);updateBal();return;}if(action==='raise'){if(pokerBetAmt>balance){toast('Not enough!');return;}balance-=pokerBetAmt;totalWagered+=pokerBetAmt;pokerBetAmt*=2;pokerPot+=pokerBetAmt/2*2;updateBal();document.getElementById('poker-pot').textContent='Pot: '+fmt(pokerPot);}if(action==='allin'){const all=balance;pokerPot+=all*2;totalWagered+=all;balance=0;pokerBetAmt+=all;updateBal();document.getElementById('poker-pot').textContent='Pot: '+fmt(pokerPot);}if(pokerStage==='flop'){pokerComm=[rCard(),rCard(),rCard()];document.getElementById('poker-comm').innerHTML=pokerComm.map(mkCard).join('');document.getElementById('poker-stage').textContent='FLOP';pokerStage='turn';}else if(pokerStage==='turn'){pokerComm.push(rCard());document.getElementById('poker-comm').innerHTML=pokerComm.map(mkCard).join('');document.getElementById('poker-stage').textContent='TURN';pokerStage='river';}else if(pokerStage==='river'){pokerComm.push(rCard());document.getElementById('poker-comm').innerHTML=pokerComm.map(mkCard).join('');document.getElementById('poker-stage').textContent='RIVER';pokerStage='showdown';}else if(pokerStage==='showdown'){const all=[...pokerHole,...pokerComm];const rank=evalHand(all);const ps=getHandStrength(all);const ds=Math.random()*10;const win=ps>ds?pokerPot:0;pkSetButtons(false);if(win>0)balance+=win;recordBet('Poker',pokerBetAmt,win>pokerBetAmt?win:0);showResultRaw(rank+' - '+(win>0?'You win! +'+fmt(win):'Dealer wins. Lost '+fmt(pokerBetAmt)+'.'),win>0);updateBal();pokerStage='pre';return;}showHandRank();}
function evalHand(cards){const rc={};cards.forEach(c=>rc[c.r]=(rc[c.r]||0)+1);const counts=Object.values(rc).sort((a,b)=>b-a);const fc={};cards.forEach(c=>fc[c.s]=(fc[c.s]||0)+1);const isFlush=Object.values(fc).some(v=>v>=5);if(counts[0]===4)return'Four of a Kind';if(counts[0]===3&&counts[1]===2)return'Full House';if(isFlush)return'Flush';if(counts[0]===3)return'Three of a Kind';if(counts[0]===2&&counts[1]===2)return'Two Pair';if(counts[0]===2)return'One Pair';return'High Card';}
function getHandStrength(cards){const rc={};cards.forEach(c=>rc[c.r]=(rc[c.r]||0)+1);const counts=Object.values(rc).sort((a,b)=>b-a);if(counts[0]===4)return 8;if(counts[0]===3&&counts[1]===2)return 7;const fc={};cards.forEach(c=>fc[c.s]=(fc[c.s]||0)+1);if(Object.values(fc).some(v=>v>=5))return 6;if(counts[0]===3)return 4;if(counts[0]===2&&counts[1]===2)return 3;if(counts[0]===2)return 2;return 1;}

// BACCARAT
let bacBetAmt=0,bacSideBet=null;
function buildBac(){return '<div class="bac-layout"><div class="bac-game"><div class="bac-table"><div style="display:flex;justify-content:space-around"><div style="text-align:center"><div class="bac-label">PLAYER</div><div class="card-row" id="bac-player" style="justify-content:center"></div><div class="bac-score" id="bac-pscore">-</div></div><div style="display:flex;align-items:center;padding:0 8px"><div style="font-family:var(--fh);font-size:14px;color:#5a2a8a;letter-spacing:2px">VS</div></div><div style="text-align:center"><div class="bac-label">BANKER</div><div class="card-row" id="bac-banker" style="justify-content:center"></div><div class="bac-score" id="bac-bscore">-</div></div></div></div><div class="bet-type-row"><span class="bt" data-t="player" onclick="setBT(\'player\')">Player 1:1</span><span class="bt" data-t="banker" onclick="setBT(\'banker\')">Banker 0.95:1</span><span class="bt" data-t="tie" onclick="setBT(\'tie\')">Tie 8:1</span></div>'+betRow()+'<button class="play-btn" id="bac-deal-btn" onclick="doBac()">DEAL</button><div class="result-box" id="res"></div></div><div class="bac-sidebets"><div class="bj-sidebet-title">SIDE BETS</div><div class="bj-sidebet-card" id="bac-sb-pp" onclick="setBacSide(\'pair-player\',this)"><div class="bj-sidebet-name">Player Pair</div><div class="bj-sidebet-desc">Player\'s first 2 are a pair</div><div class="bj-sidebet-odds">11:1</div></div><div class="bj-sidebet-card" id="bac-sb-pb" onclick="setBacSide(\'pair-banker\',this)"><div class="bj-sidebet-name">Banker Pair</div><div class="bj-sidebet-desc">Banker\'s first 2 are a pair</div><div class="bj-sidebet-odds">11:1</div></div><div class="bj-sidebet-card" id="bac-sb-nat" onclick="setBacSide(\'natural\',this)"><div class="bj-sidebet-name">Natural Win</div><div class="bj-sidebet-desc">Winner scores natural 8 or 9</div><div class="bj-sidebet-odds">8:1</div></div><div class="bj-sidebet-card" id="bac-sb-d7" onclick="setBacSide(\'dragon7\',this)"><div class="bj-sidebet-name">Dragon 7</div><div class="bj-sidebet-desc">Banker wins 3-card totaling 7</div><div class="bj-sidebet-odds">40:1</div></div></div></div>';}
function initBac(){['bac-player','bac-banker'].forEach(id=>{const e=document.getElementById(id);if(e)e.innerHTML='';});['bac-pscore','bac-bscore'].forEach(id=>{const e=document.getElementById(id);if(e)e.textContent='-';});bacSideBet=null;}
function setBacSide(name,el){if(bacSideBet===name){bacSideBet=null;el.classList.remove('sel');}else{document.querySelectorAll('[id^="bac-sb-"]').forEach(e=>e.classList.remove('sel'));bacSideBet=name;el.classList.add('sel');}}
function doBac(){const bet=getBet();if(!bet||bet>balance){toast('Invalid bet!');return;}if(!activeBetType){toast('Pick Player, Banker, or Tie!');return;}const sideCost=bacSideBet?bet*.25:0;if(bet+sideCost>balance){toast('Not enough!');return;}const btn=document.getElementById('bac-deal-btn');btn.disabled=true;const ph=[rCard(),rCard()],bh=[rCard(),rCard()];let step=0;const deal=setInterval(()=>{if(step===0)document.getElementById('bac-player').innerHTML=mkCard(ph[0]);else if(step===1)document.getElementById('bac-banker').innerHTML=mkCard(bh[0]);else if(step===2)document.getElementById('bac-player').innerHTML=ph.map(mkCard).join('');else if(step===3){document.getElementById('bac-banker').innerHTML=bh.map(mkCard).join('');clearInterval(deal);const pv=hVal(ph)%10,bv=hVal(bh)%10;document.getElementById('bac-pscore').textContent=pv;document.getElementById('bac-bscore').textContent=bv;const winner=pv>bv?'player':bv>pv?'banker':'tie';const m=activeBetType==='player'?2:activeBetType==='banker'?1.95:9;let totalBet=bet,win=activeBetType===winner?parseFloat((bet*m).toFixed(2)):0,sideWin=0;if(bacSideBet){totalBet+=sideCost;if(bacSideBet==='pair-player'&&cVal(ph[0].r)===cVal(ph[1].r))sideWin=sideCost*11;if(bacSideBet==='pair-banker'&&cVal(bh[0].r)===cVal(bh[1].r))sideWin=sideCost*11;if(bacSideBet==='natural'&&(pv>=8||bv>=8))sideWin=sideCost*8;if(bacSideBet==='dragon7'&&winner==='banker'&&bv===7)sideWin=sideCost*40;}balance-=totalBet;if(win>0)balance+=win;if(sideWin>0)balance+=sideWin;recordBet('Baccarat',totalBet,(win+sideWin)>totalBet?(win+sideWin):0);let msg='Player '+pv+' vs Banker '+bv+' - '+winner+' wins! '+(win>0?'Won '+fmt(win):'Lost '+fmt(bet)+'.');if(sideWin>0)msg+=' Side: +'+fmt(sideWin)+'!';showResultRaw(msg,win>0||sideWin>0);btn.disabled=false;updateBal();}step++;},320);}

