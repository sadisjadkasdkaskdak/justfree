function doSlots(id){const bet=getBet();if(!bet||bet>balance){toast('Invalid bet!');return;}const th=slotThemes[id]||slotThemes.slots_candy;const syms=th.syms;const btn=document.getElementById('slots-spin-btn');btn.disabled=true;btn.textContent='SPINNING...';const resultIdxs=[0,1,2,3,4].map(()=>Math.floor(Math.random()*syms.length));const reelSyms=resultIdxs.map(i=>syms[i]);const matches={};reelSyms.forEach(s=>matches[s]=(matches[s]||0)+1);const maxMatch=Math.max(...Object.values(matches));const matchSym=Object.keys(matches).find(k=>matches[k]===maxMatch);let win=0,msg='';if(maxMatch===5){const m=matchSym==='💎'?200:matchSym==='⚡'?100:20;win=bet*m;msg='5 OF A KIND! '+m+'x!';}else if(maxMatch===4){win=bet*10;msg='Four '+matchSym+'! 10x!';}else if(maxMatch===3){win=bet*4;msg='Three '+matchSym+'! 4x!';}else if(maxMatch===2){win=parseFloat((bet*1.5).toFixed(2));msg='Pair! 1.5x!';}else{msg='No match. Lost '+fmt(bet)+'.';}let settled=0;for(let i=0;i<5;i++){const strip=document.getElementById('strip-'+i);if(!strip)continue;const ti=resultIdxs[i];const spins=2+i;const allSyms=[];for(let s=0;s<spins*syms.length+ti+1;s++)allSyms.push(syms[s%syms.length]);strip.style.transition='none';strip.innerHTML=allSyms.map(x=>'<div class="slot-sym">'+x+'</div>').join('');strip.style.transform='translateY(0px)';const tY=-(allSyms.length-1)*90;const dur=500+i*120;setTimeout(()=>{strip.style.transition='transform '+dur+'ms cubic-bezier(.25,.46,.45,.94)';strip.style.transform='translateY('+tY+'px)';},50+i*80);setTimeout(()=>{strip.style.transition='none';strip.innerHTML=syms.map(x=>'<div class="slot-sym">'+x+'</div>').join('');strip.style.transform='translateY('+ (-ti*90)+'px)';settled++;if(settled===5){if(th.hasLightning&&win>0){const ov=document.getElementById('lightning-ov');if(ov){ov.className='lightning-overlay strike';setTimeout(()=>{if(ov)ov.className='lightning-overlay';},700);}}btn.disabled=false;btn.textContent='SPIN';balance-=bet;if(win>0)balance+=win;recordBet('Slots',bet,win>bet?win:0);showResultRaw(msg,win>0);updateBal();}},50+i*80+dur+60);}};

// BLACKJACK
let bjPlayer=[],bjDealer=[],bjBetAmt=0,bjOver=false,bjSideBets={};
function buildBJ(){return '<div class="bj-layout"><div class="bj-game"><div class="bj-table"><div class="bj-label">DEALER</div><div class="card-row" id="bj-dealer"></div><div class="bj-score" id="bj-dscore"></div><div style="height:6px"></div><div class="bj-label">YOUR HAND</div><div class="card-row" id="bj-player"></div><div class="bj-score" id="bj-pscore"></div></div><div class="bj-actions"><button class="bj-btn" id="bj-hit" onclick="bjHit()" disabled>Hit</button><button class="bj-btn" id="bj-stand" onclick="bjStand()" disabled>Stand</button><button class="bj-btn" id="bj-double" onclick="bjDouble()" disabled>Double</button><button class="bj-btn" id="bj-split" onclick="bjSplit()" disabled>Split</button></div>'+betRow()+'<button class="play-btn" id="bj-deal" onclick="bjDeal()">DEAL</button><div class="result-box" id="res"></div></div><div class="bj-sidebets"><div class="bj-sidebet-title">SIDE BETS</div><div class="bj-sidebet-card" id="sb-perfect-pairs" onclick="toggleSideBet(\'perfect-pairs\',this)"><div class="bj-sidebet-name">Perfect Pairs</div><div class="bj-sidebet-desc">First two cards are a pair</div><div class="bj-sidebet-odds">25:1</div></div><div class="bj-sidebet-card" id="sb-21plus3" onclick="toggleSideBet(\'21plus3\',this)"><div class="bj-sidebet-name">21+3</div><div class="bj-sidebet-desc">Your 2 + dealer upcard = poker hand</div><div class="bj-sidebet-odds">40:1</div></div><div class="bj-sidebet-card" id="sb-lucky-ladies" onclick="toggleSideBet(\'lucky-ladies\',this)"><div class="bj-sidebet-name">Lucky Ladies</div><div class="bj-sidebet-desc">First two total 20</div><div class="bj-sidebet-odds">200:1</div></div><div class="bj-sidebet-card" id="sb-insurance" onclick="toggleSideBet(\'insurance\',this)"><div class="bj-sidebet-name">Insurance</div><div class="bj-sidebet-desc">Dealer has Blackjack?</div><div class="bj-sidebet-odds">2:1</div></div><div style="margin-top:8px;font-size:10px;color:var(--txt2);font-family:var(--fu)">Side bet = 25% of main</div></div></div>';}
