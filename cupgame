// WHEEL - accurate spin to result
const wofSegments=[{label:'0.2x',color:'#cc2200',mult:.2},{label:'0.5x',color:'#883300',mult:.5},{label:'1x',color:'#2255aa',mult:1},{label:'2x',color:'#1a7a22',mult:2},{label:'0.2x',color:'#cc2200',mult:.2},{label:'5x',color:'#4488ff',mult:5},{label:'0.5x',color:'#883300',mult:.5},{label:'1x',color:'#2255aa',mult:1},{label:'BONUS',color:'#ffd700',mult:10},{label:'0.2x',color:'#cc2200',mult:.2},{label:'2x',color:'#1a7a22',mult:2},{label:'1x',color:'#2255aa',mult:1},{label:'0.5x',color:'#883300',mult:.5},{label:'20x',color:'#aa44ff',mult:20},{label:'0.2x',color:'#cc2200',mult:.2},{label:'1x',color:'#2255aa',mult:1}];
let wofAngle=0,wofSpinning=false;
function buildWOF(){return '<div class="wheel-wrap"><canvas id="wof-canvas" width="260" height="260"></canvas><div class="wof-pointer"></div></div><div class="wof-result" id="wof-result"></div>'+(adminMode?'<div style="text-align:center;font-size:11px;color:#ff3355;font-family:var(--fd);margin:4px 0">ADMIN: Lands on <span id="wof-admin-seg">?</span></div>':'')+'<div class="result-box" id="res"></div>'+betRow()+'<button class="play-btn" id="wof-btn" onclick="spinWOF()">SPIN THE WHEEL</button>';}
function initWOF(){wofAngle=0;drawWOF();}
function drawWOF(){const c=document.getElementById('wof-canvas');if(!c)return;const ctx=c.getContext('2d');const W=c.width,cx=W/2,cy=W/2,r=W/2-4;const n=wofSegments.length;for(let i=0;i<n;i++){const a1=wofAngle+i/n*Math.PI*2-Math.PI/2,a2=wofAngle+(i+1)/n*Math.PI*2-Math.PI/2;ctx.beginPath();ctx.moveTo(cx,cy);ctx.arc(cx,cy,r,a1,a2);ctx.closePath();ctx.fillStyle=wofSegments[i].color;ctx.fill();ctx.strokeStyle='rgba(0,0,0,.3)';ctx.lineWidth=1;ctx.stroke();const ma=(a1+a2)/2;ctx.save();ctx.translate(cx+Math.cos(ma)*(r*.72),cy+Math.sin(ma)*(r*.72));ctx.rotate(ma+Math.PI/2);ctx.fillStyle='#fff';ctx.font='bold 8px Orbitron,monospace';ctx.textAlign='center';ctx.fillText(wofSegments[i].label,0,3);ctx.restore();}ctx.beginPath();ctx.arc(cx,cy,r*.12,0,Math.PI*2);ctx.fillStyle='#111';ctx.fill();ctx.strokeStyle='#ffd700';ctx.lineWidth=2;ctx.stroke();}
function spinWOF(){if(wofSpinning)return;const bet=getBet();if(!bet||bet>balance){toast('Invalid bet!');return;}const resultIdx=Math.floor(Math.random()*wofSegments.length);const seg=wofSegments[resultIdx];if(adminMode){const aw=document.getElementById('wof-admin-seg');if(aw)aw.textContent=seg.label;}wofSpinning=true;document.getElementById('wof-btn').disabled=true;document.getElementById('wof-result').textContent='';const n=wofSegments.length;const segMidFrac=(resultIdx+.5)/n;const segMidAngle=segMidFrac*Math.PI*2;const spins=5+Math.floor(Math.random()*4);const targetAngle=spins*Math.PI*2+(Math.PI/2*3-segMidAngle);const startAngle=wofAngle;const totalDelta=targetAngle-(wofAngle%(Math.PI*2));const endAngle=wofAngle+totalDelta+(spins-1)*Math.PI*2;const duration=3800;const startTime=performance.now();function frame(now){const elapsed=now-startTime;const p=Math.min(elapsed/duration,1);const ease=1-Math.pow(1-p,4);wofAngle=startAngle+(endAngle-startAngle)*ease;drawWOF();if(p<1){requestAnimationFrame(frame);}else{wofSpinning=false;document.getElementById('wof-btn').disabled=false;const win=parseFloat((bet*seg.mult).toFixed(2));balance-=bet;if(win>0)balance+=win;document.getElementById('wof-result').textContent=seg.label;recordBet('Wheel',bet,win>bet?win:0);showResultRaw(seg.mult>=1?'Landed '+seg.label+'! Won '+fmt(win):'Landed '+seg.label+'. Lost '+fmt(bet-win)+'.',seg.mult>=1);updateBal();}}requestAnimationFrame(frame);}

// VIDEO POKER
let vpCards=[],vpHeld=new Set(),vpPhase='idle',vpBet=0;
const vpPaytable=[{hand:'Royal Flush',pays:800},{hand:'Straight Flush',pays:50},{hand:'Four of a Kind',pays:25},{hand:'Full House',pays:9},{hand:'Flush',pays:6},{hand:'Straight',pays:4},{hand:'Three of a Kind',pays:3},{hand:'Two Pair',pays:2},{hand:'Jacks or Better',pays:1},{hand:'Nothing',pays:0}];
function buildVP(){return '<div class="vp-paytable">'+vpPaytable.map(r=>'<div class="vp-pt-row"><span class="vp-pt-hand">'+r.hand+'</span><span class="vp-pt-pay">'+r.pays+':1</span></div>').join('')+'</div><div class="vp-cards" id="vp-cards">'+[0,1,2,3,4].map(i=>'<div class="vp-card-wrap"><div class="vp-hold" id="vph-'+i+'">HOLD</div><div class="vp-pcard back" id="vpc-'+i+'" onclick="vpToggleHold('+i+')">&#127136;</div></div>').join('')+'</div><div class="hand-rank" id="vp-rank" style="font-size:14px;margin:6px 0"></div>'+betRow()+'<button class="play-btn" id="vp-deal-btn" onclick="vpDeal()">DEAL / DRAW</button><div class="result-box" id="res"></div>';}
function initVP(){vpPhase='idle';vpCards=[];vpHeld.clear();}
function vpToggleHold(i){if(vpPhase!=='hold')return;if(vpHeld.has(i)){vpHeld.delete(i);document.getElementById('vph-'+i).classList.remove('held');document.getElementById('vpc-'+i).classList.remove('held-card');}else{vpHeld.add(i);document.getElementById('vph-'+i).classList.add('held');document.getElementById('vpc-'+i).classList.add('held-card');}}
function vpDeal(){const bet=getBet();if(vpPhase==='idle'||vpPhase==='done'){if(!bet||bet>balance){toast('Invalid bet!');return;}vpBet=bet;balance-=bet;updateBal();vpCards=[rCard(),rCard(),rCard(),rCard(),rCard()];vpHeld.clear();vpPhase='hold';for(let i=0;i<5;i++){const cv=vpCards[i];const red=cv.s==='♥'||cv.s==='♦';document.getElementById('vpc-'+i).className='vp-pcard '+(red?'red':'black');document.getElementById('vpc-'+i).innerHTML=cv.r+'<br>'+cv.s;document.getElementById('vph-'+i).classList.remove('held');document.getElementById('vpc-'+i).classList.remove('held-card');}document.getElementById('vp-deal-btn').textContent='DRAW';document.getElementById('vp-rank').textContent='Hold cards, then Draw';document.getElementById('res').className='result-box';}else if(vpPhase==='hold'){for(let i=0;i<5;i++){if(!vpHeld.has(i)){vpCards[i]=rCard();const cv=vpCards[i];const red=cv.s==='♥'||cv.s==='♦';document.getElementById('vpc-'+i).className='vp-pcard '+(red?'red':'black');document.getElementById('vpc-'+i).innerHTML=cv.r+'<br>'+cv.s;document.getElementById('vph-'+i).classList.remove('held');document.getElementById('vpc-'+i).classList.remove('held-card');}}vpPhase='done';document.getElementById('vp-deal-btn').textContent='NEW HAND';const rank=vpEvalHand(vpCards);const entry=vpPaytable.find(r=>vpMatchesHand(vpCards,r.hand));const mult=entry?entry.pays:0;const win=mult>0?parseFloat((vpBet*mult).toFixed(2)):0;if(win>0)balance+=win;document.getElementById('vp-rank').textContent=rank+(mult>0?' - '+mult+':1!':'');recordBet('Video Poker',vpBet,win>vpBet?win:0);showResultRaw(mult>0?rank+'! Won '+fmt(win)+'!':'Nothing. Lost '+fmt(vpBet)+'.',mult>0);updateBal();}}
function vpEvalHand(cards){const rc={};cards.forEach(c=>rc[c.r]=(rc[c.r]||0)+1);const counts=Object.values(rc).sort((a,b)=>b-a);const vals=cards.map(c=>cVal(c.r)).sort((a,b)=>a-b);const isFlush=new Set(cards.map(c=>c.s)).size===1;const isStraight=vals[4]-vals[0]===4&&new Set(vals).size===5;if(isStraight&&isFlush&&vals[0]===10)return'Royal Flush';if(isStraight&&isFlush)return'Straight Flush';if(counts[0]===4)return'Four of a Kind';if(counts[0]===3&&counts[1]===2)return'Full House';if(isFlush)return'Flush';if(isStraight)return'Straight';if(counts[0]===3)return'Three of a Kind';if(counts[0]===2&&counts[1]===2)return'Two Pair';if(counts[0]===2){const pair=Object.keys(rc).find(k=>rc[k]===2);if(cVal(pair)>=11||pair==='A')return'Jacks or Better';}return'Nothing';}
function vpMatchesHand(cards,handName){return vpEvalHand(cards)===handName;}

