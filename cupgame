function buildAviatorHTML(){return '<style>#aviator-overlay *{box-sizing:border-box;margin:0;padding:0}.av-top{display:flex;align-items:center;gap:10px;padding:10px 18px;background:#050b14;border-bottom:1px solid #0e1e30;flex-shrink:0}.av-logo{font-family:Orbitron,monospace;font-size:18px;font-weight:900;color:#ff3355;letter-spacing:3px}.av-hbar{display:flex;gap:5px;flex:1;overflow-x:auto;align-items:center}.av-hp{padding:2px 8px;border-radius:10px;font-family:Orbitron,monospace;font-size:9px;font-weight:700;border:1px solid;white-space:nowrap;flex-shrink:0}.av-hp.low{background:#ff335515;border-color:#ff335550;color:#ff3355}.av-hp.mid{background:#00ff8815;border-color:#00ff8850;color:#00ff88}.av-hp.high{background:#ffd70015;border-color:#ffd70050;color:#ffd700}.av-close{background:#0e1e30;border:1px solid #1a3050;color:#a0c0e0;padding:6px 14px;border-radius:6px;cursor:pointer;font-family:Rajdhani,sans-serif;font-size:12px;font-weight:700;flex-shrink:0}.av-close:hover{border-color:#ff3355;color:#ff3355}.av-chart{flex:1;position:relative;overflow:hidden;min-height:0}#av-canvas{width:100%;height:100%;display:block}.av-ovl{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);text-align:center;pointer-events:none}.av-mb{font-family:Orbitron,monospace;font-size:clamp(28px,5vw,68px);font-weight:900;color:#00ff88;text-shadow:0 0 40px #00ff88;letter-spacing:2px;transition:color .15s,text-shadow .15s}.av-mb.crashed{color:#ff3355;text-shadow:0 0 40px #ff3355}.av-sub{font-family:Rajdhani,sans-serif;font-size:13px;color:rgba(160,200,230,.5);letter-spacing:2px;margin-top:4px}.av-bot{display:flex;gap:10px;padding:10px 14px;background:#050b14;border-top:1px solid #0e1e30;flex-shrink:0;flex-wrap:wrap}.av-pan{background:#09111e;border:1px solid #0e1e30;border-radius:10px;padding:12px;flex:1;min-width:190px}.av-pt{font-size:9px;color:#2a5060;font-family:Rajdhani,sans-serif;font-weight:700;letter-spacing:2px;text-transform:uppercase;margin-bottom:8px}.av-sr{display:flex;gap:7px;margin-bottom:9px}.av-s{background:#030810;border:1px solid #0e1e30;border-radius:6px;padding:6px 9px;flex:1}.av-sv{font-family:Orbitron,monospace;font-size:12px;font-weight:700;color:#00ff88}.av-sv.neg{color:#ff3355}.av-sl{font-size:9px;color:#2a5060;font-family:Rajdhani,sans-serif;font-weight:600;margin-top:1px}.av-in{background:#030810;border:1px solid #0e1e30;border-radius:6px;padding:8px 10px;color:#fff;font-size:14px;font-family:Orbitron,monospace;outline:none;width:100%;margin-bottom:6px}.av-in:focus{border-color:#00ff88}.av-hd-row{display:flex;gap:5px;margin-bottom:7px}.av-hd{background:#030810;border:1px solid #0e1e30;border-radius:4px;padding:4px;font-size:11px;color:#2a5060;cursor:pointer;font-family:Rajdhani,sans-serif;font-weight:700;flex:1;text-align:center;transition:all .15s}.av-hd:hover{border-color:#00ff88;color:#00ff88}.av-ar{display:flex;align-items:center;gap:6px;margin-bottom:8px;font-size:11px;color:#2a5060;font-family:Rajdhani,sans-serif;font-weight:600;flex-wrap:wrap}.av-ai{background:#030810;border:1px solid #0e1e30;border-radius:4px;padding:4px 7px;color:#fff;font-size:11px;width:60px;outline:none;font-family:Orbitron,monospace}.av-ai:focus{border-color:#00ff88}.av-tg{position:relative;display:inline-flex;cursor:pointer}.av-tg input{opacity:0;width:0;height:0;position:absolute}.av-tt{width:34px;height:18px;background:#0e1e30;border-radius:9px;display:flex;align-items:center;padding:2px;transition:all .2s;border:1px solid #1a3050}.av-th{width:12px;height:12px;background:#2a5060;border-radius:50%;transition:all .2s}.av-tg input:checked+.av-tt{background:#00ff88;border-color:#00ff88}.av-tg input:checked+.av-tt .av-th{transform:translateX(16px);background:#030810}.av-sp{display:flex;gap:4px;margin-bottom:8px}.av-spb{background:#030810;border:1px solid #0e1e30;border-radius:4px;padding:4px;font-size:10px;color:#2a5060;cursor:pointer;font-family:Rajdhani,sans-serif;font-weight:700;flex:1;text-align:center;transition:all .15s}.av-spb:hover,.av-spb.sel{border-color:#4488ff;color:#4488ff;background:#4488ff10}.av-bb{width:100%;background:linear-gradient(135deg,#00ff88,#00cc66);color:#030810;border:none;border-radius:8px;padding:11px;font-size:14px;font-weight:900;cursor:pointer;font-family:Orbitron,monospace;letter-spacing:1px;transition:all .15s;margin-top:2px}.av-bb:hover{filter:brightness(1.1)}.av-bb:disabled{background:#0e1e30;color:#2a5060;cursor:not-allowed;filter:none}.av-cb{width:100%;background:linear-gradient(135deg,#ffd700,#ffaa00);color:#030810;border:none;border-radius:8px;padding:11px;font-size:14px;font-weight:900;cursor:pointer;font-family:Orbitron,monospace;letter-spacing:1px;transition:all .15s;display:none;margin-top:2px}.av-cb:hover{filter:brightness(1.1)}.av-adm{background:#ff335510;border:1px solid #ff335530;border-radius:5px;padding:5px 9px;font-size:10px;color:#ff3355;font-family:Orbitron,monospace;margin-bottom:8px;text-align:center;display:none}.av-lf{max-height:100px;overflow-y:auto}.av-be{display:flex;justify-content:space-between;padding:3px 0;border-bottom:1px solid #0e1e30;font-size:11px}.av-bu{color:#a0c0e0;font-family:Rajdhani,sans-serif;font-weight:600}.av-bm{font-family:Orbitron,monospace;font-size:9px;color:#2a5060}.av-bw{color:#00ff88;font-family:Orbitron,monospace;font-size:9px}.av-bl{color:#ff3355;font-family:Orbitron,monospace;font-size:9px}</style><div class="av-top"><div class="av-logo">AVIATOR</div><div class="av-hbar" id="av-hbar"></div><button class="av-close" onclick="closeAviator()">CLOSE</button></div><div class="av-chart" id="av-chart"><canvas id="av-canvas"></canvas><div class="av-ovl"><div class="av-mb" id="av-mult">Waiting...</div><div class="av-sub" id="av-sub">NEXT ROUND SOON</div></div></div><div class="av-bot"><div class="av-pan" style="max-width:255px"><div class="av-pt">YOUR BET</div><div class="av-adm" id="av-adm">ADMIN: Crash @ <b id="av-at">?</b></div><div class="av-sr"><div class="av-s"><div class="av-sv" id="av-bal">$0</div><div class="av-sl">BALANCE</div></div><div class="av-s"><div class="av-sv" id="av-pnl">$0.00</div><div class="av-sl">SESSION P&L</div></div></div><input class="av-in" id="av-bin" type="number" value="1000" min="1" placeholder="Bet amount"/><div class="av-hd-row"><span class="av-hd" onclick="(()=>{const v=parseFloat(document.getElementById(\'av-bin\').value||0);document.getElementById(\'av-bin\').value=Math.max(1,Math.round(v/2));})()">1/2</span><span class="av-hd" onclick="(()=>{const v=parseFloat(document.getElementById(\'av-bin\').value||0);document.getElementById(\'av-bin\').value=Math.round(v*2);})()">2x</span><span class="av-hd" onclick="document.getElementById(\'av-bin\').value=Math.round(balance)">Max</span></div><div class="av-ar"><label class="av-tg"><input type="checkbox" id="av-acb"><span class="av-tt"><span class="av-th"></span></span></label>Auto cashout at <input type="number" class="av-ai" id="av-acv" value="2.00" min="1.01" step="0.1"/>x</div><div class="av-sp"><span class="av-spb" onclick="avSpd(.5,this)">SLOW</span><span class="av-spb sel" onclick="avSpd(1,this)">NORMAL</span><span class="av-spb" onclick="avSpd(2,this)">FAST</span><span class="av-spb" onclick="avSpd(99,this)">TURBO</span></div><button class="av-bb" id="av-bbt" onclick="avBet()">BET</button><button class="av-cb" id="av-cbt" onclick="avCO()">CASH OUT <span id="av-cov"></span></button></div><div class="av-pan" style="flex:2"><div class="av-pt">ROUND HISTORY</div><div style="display:flex;gap:4px;flex-wrap:wrap" id="av-hpills"></div></div><div class="av-pan" style="flex:2"><div class="av-pt">LIVE BETS</div><div class="av-lf" id="av-lf"></div></div></div>';}

let avState={phase:'waiting',mult:1,betAmt:0,betting:false,animId:null,cdTimer:null,round:null,sessionPnl:0,speed:1,history:[],chartPoints:[]};
let avLivePlayers=[];
const avNames=['CryptoKing','LuckyAce','BlazeFox','HighRoller','Shadow99','NeonRider','GoldRush','IronDuke','StarWolf','DarkHorse'];
function avSpd(s,el){avState.speed=s;document.querySelectorAll('.av-spb').forEach(e=>e.classList.remove('sel'));el.classList.add('sel');}
function avRsz(){const area=document.getElementById('av-chart');const c=document.getElementById('av-canvas');if(!area||!c)return;c.width=area.offsetWidth||800;c.height=area.offsetHeight||300;}
function initAviator(){avCancelAnim();avState={phase:'waiting',mult:1,betAmt:0,betting:false,animId:null,cdTimer:null,round:null,sessionPnl:0,speed:1,history:[],chartPoints:[]};avLivePlayers=avNames.map(n=>({name:n,bet:parseFloat((Math.random()*2000+50).toFixed(2)),cashedAt:null,lost:false}));if(adminMode){const ab=document.getElementById('av-adm');if(ab)ab.style.display='block';}avRsz();avUIUpdate();avStartCD();setInterval(avLFUpdate,1600);}
function avStartCD(){if(!document.getElementById('av-canvas')){avCancelAnim();return;}avState.phase='waiting';avState.round=generateCrashRound();avState.chartPoints=[[0,1]];avState.mult=1;avLivePlayers=avNames.map(n=>({name:n,bet:parseFloat((Math.random()*2000+50).toFixed(2)),cashedAt:null,lost:false}));const mEl=document.getElementById('av-mult');if(mEl){mEl.textContent='1.00x';mEl.className='av-mb';}const sEl=document.getElementById('av-sub');if(adminMode){const at=document.getElementById('av-at');if(at)at.textContent=avState.round.crashAt.toFixed(2)+'x';}avUIUpdate();avLFUpdate();avDrawChart();let cd=4;avState.cdTimer=setInterval(()=>{if(!document.getElementById('av-canvas')){clearInterval(avState.cdTimer);return;}cd--;if(sEl)sEl.textContent=cd>0?'STARTING IN '+cd+'...':'FLYING!';if(cd<=0){clearInterval(avState.cdTimer);avState.cdTimer=null;avStartFlight();}},1000);}
function avStartFlight(){if(!document.getElementById('av-canvas'))return;avState.phase='flying';let t=0;function step(){if(!document.getElementById('av-canvas')){avState.animId=null;return;}const steps=avState.speed===99?999:1;for(let s=0;s<steps;s++){t+=.08;avState.mult=parseFloat(Math.pow(Math.E,t*.14).toFixed(2));avState.chartPoints.push([t,avState.mult]);const autoCb=document.getElementById('av-acb');const autoVal=parseFloat(document.getElementById('av-acv')?.value||2);if(autoCb?.checked&&avState.betting&&avState.mult>=autoVal)avCO();avLivePlayers.forEach(p=>{if(!p.cashedAt&&!p.lost&&avState.mult>=(1.3+Math.random()*3.5)&&Math.random()<.08)p.cashedAt=avState.mult.toFixed(2);});if(avState.betting){const cv=document.getElementById('av-cov');if(cv)cv.textContent=fmt(avState.betAmt*avState.mult);}const mEl=document.getElementById('av-mult');if(mEl){mEl.textContent=avState.mult.toFixed(2)+'x';const col=avState.mult<2?'#00ff88':avState.mult<5?'#ffd700':avState.mult<10?'#ff8822':'#ff3355';mEl.style.color=col;mEl.style.textShadow='0 0 40px '+col;}if(avState.mult>=avState.round.crashAt){avState.phase='crashed';if(avState.betting){avState.betting=false;balance-=avState.betAmt;recordBet('Aviator',avState.betAmt,0);avUIUpdate();toast('Aviator crashed! Lost '+fmt(avState.betAmt),true);}avLivePlayers.forEach(p=>{if(!p.cashedAt)p.lost=true;});const m2=document.getElementById('av-mult');if(m2){m2.textContent=avState.mult.toFixed(2)+'x CRASHED';m2.className='av-mb crashed';}const sEl2=document.getElementById('av-sub');if(sEl2)sEl2.textContent='CRASHED @ '+avState.mult.toFixed(2)+'x';document.getElementById('av-cbt').style.display='none';document.getElementById('av-bbt').disabled=false;document.getElementById('av-bbt').textContent='BET';avAddHist(avState.mult);avLFUpdate();avDrawChart();avState.animId=null;setTimeout(()=>avStartCD(),3500);return;}}avDrawChart();avLFUpdate();avState.animId=avState.speed===99?null:requestAnimationFrame(step);if(avState.speed===99)setTimeout(()=>avStartCD(),1500);}avState.animId=requestAnimationFrame(step);}
function avBet(){const bet=parseFloat(document.getElementById('av-bin')?.value||0);if(!bet||bet>balance||bet<=0){toast('Invalid bet!');return;}if(avState.phase==='crashed'){toast('Wait for next round!');return;}avState.betAmt=bet;avState.betting=true;balance-=bet;avUIUpdate();document.getElementById('av-bbt').disabled=true;document.getElementById('av-bbt').textContent='IN FLIGHT...';document.getElementById('av-cbt').style.display='block';document.getElementById('av-cov').textContent=fmt(bet);toast('Bet placed: '+fmt(bet));}
function avCO(){if(!avState.betting)return;avState.betting=false;const win=parseFloat((avState.betAmt*avState.mult).toFixed(2));avState.sessionPnl+=win-avState.betAmt;balance+=win;recordBet('Aviator',avState.betAmt,win);avUIUpdate();document.getElementById('av-cbt').style.display='none';document.getElementById('av-bbt').disabled=false;document.getElementById('av-bbt').textContent='BET';toast('Cashed at '+avState.mult.toFixed(2)+'x! +'+fmt(win)+'!');}
function avUIUpdate(){const b=document.getElementById('av-bal');if(b)b.textContent=fmt(balance);const p=document.getElementById('av-pnl');if(p){p.textContent=fmt(avState.sessionPnl);p.className='av-sv'+(avState.sessionPnl<0?' neg':'');}updateBal();}
function avAddHist(mult){avState.history.unshift(mult);if(avState.history.length>20)avState.history.pop();const bar=document.getElementById('av-hbar');if(bar)bar.innerHTML=avState.history.slice(0,12).map(m=>'<span class="av-hp '+(m<2?'low':m<10?'mid':'high')+'">'+m.toFixed(2)+'x</span>').join('');const pills=document.getElementById('av-hpills');if(pills)pills.innerHTML=avState.history.map(m=>'<span class="av-hp '+(m<2?'low':m<10?'mid':'high')+'">'+m.toFixed(2)+'x</span>').join('');}
function avLFUpdate(){const feed=document.getElementById('av-lf');if(!feed)return;feed.innerHTML=avLivePlayers.map(p=>'<div class="av-be"><span class="av-bu">'+p.name+'</span><span class="av-bm">'+(p.cashedAt?p.cashedAt+'x':avState.phase==='flying'?avState.mult.toFixed(2)+'x':'—')+'</span><span class="'+(p.cashedAt?'av-bw':p.lost?'av-bl':'')+'">'+(p.cashedAt?'+'+fmt(p.bet*parseFloat(p.cashedAt)):p.lost?'-'+fmt(p.bet):fmt(p.bet))+'</span></div>').join('');}
function avDrawChart(){const c=document.getElementById('av-canvas');if(!c)return;avRsz();const ctx=c.getContext('2d');const W=c.width,H=c.height;const pts=avState.chartPoints;ctx.fillStyle='#03060a';ctx.fillRect(0,0,W,H);ctx.fillStyle='rgba(255,255,255,.12)';for(let i=0;i<60;i++)ctx.fillRect((i*137)%W,(i*97)%H,1,1);ctx.strokeStyle='#071220';ctx.lineWidth=1;for(let i=1;i<=5;i++){ctx.beginPath();ctx.moveTo(0,H*i/5);ctx.lineTo(W,H*i/5);ctx.stroke();}for(let i=1;i<=8;i++){ctx.beginPath();ctx.moveTo(W*i/8,0);ctx.lineTo(W*i/8,H);ctx.stroke();}if(pts.length<2)return;const maxX=pts[pts.length-1][0];const maxY=Math.max(...pts.map(p=>p[1]),1.5);const tX=t=>(t/maxX)*(W-40)+20;const tY=v=>H-30-((v-1)/(maxY-1))*(H-60);const crashed=avState.phase==='crashed';const lc=crashed?'#ff3355':'#00ff88';const fill=ctx.createLinearGradient(0,0,0,H);fill.addColorStop(0,crashed?'rgba(255,51,85,.18)':'rgba(0,255,136,.13)');fill.addColorStop(1,'transparent');ctx.beginPath();ctx.moveTo(tX(pts[0][0]),H-30);pts.forEach(p=>ctx.lineTo(tX(p[0]),tY(p[1])));ctx.lineTo(tX(pts[pts.length-1][0]),H-30);ctx.closePath();ctx.fillStyle=fill;ctx.fill();ctx.beginPath();ctx.moveTo(tX(pts[0][0]),tY(pts[0][1]));pts.forEach(p=>ctx.lineTo(tX(p[0]),tY(p[1])));ctx.strokeStyle=lc;ctx.lineWidth=2.5;ctx.shadowColor=lc;ctx.shadowBlur=14;ctx.stroke();ctx.shadowBlur=0;const lp=pts[pts.length-1];const lx=tX(lp[0]),ly=tY(lp[1]);if(!crashed){ctx.save();ctx.translate(lx,ly);ctx.rotate(-Math.PI/7);for(let i=1;i<=5;i++){ctx.beginPath();ctx.arc(-i*10,Math.random()*4-2,2.5,0,Math.PI*2);ctx.fillStyle='rgba(200,220,200,'+(0.28-i*.04)+')';ctx.fill();}ctx.beginPath();ctx.moveTo(0,0);ctx.lineTo(-26,7);ctx.lineTo(-22,0);ctx.lineTo(-26,-7);ctx.closePath();ctx.fillStyle='#00ff88';ctx.shadowColor='#00ff88';ctx.shadowBlur=14;ctx.fill();ctx.shadowBlur=0;ctx.beginPath();ctx.moveTo(-6,0);ctx.lineTo(-17,-15);ctx.lineTo(-21,-4);ctx.closePath();ctx.fillStyle='#00cc66';ctx.fill();ctx.beginPath();ctx.moveTo(-6,0);ctx.lineTo(-17,15);ctx.lineTo(-21,4);ctx.closePath();ctx.fillStyle='#00cc66';ctx.fill();ctx.restore();}else{ctx.font='22px serif';ctx.textAlign='center';ctx.fillText('💥',lx,ly+6);}if(adminMode&&avState.round){avState.round.nodes.forEach(node=>{const nx=tX(node.pos/100*maxX);ctx.strokeStyle=node.type==='ROCKET'?'rgba(255,51,85,.4)':node.type==='MULT'?'rgba(68,136,255,.4)':'rgba(0,255,136,.4)';ctx.lineWidth=1;ctx.setLineDash([3,3]);ctx.beginPath();ctx.moveTo(nx,0);ctx.lineTo(nx,H);ctx.stroke();ctx.setLineDash([]);});}[1,1.5,2,3,5,10,25,50].filter(v=>v<=maxY*1.1).forEach(v=>{const y=tY(v);if(y>8&&y<H-8){ctx.fillStyle='#0e2230';ctx.font='9px monospace';ctx.textAlign='left';ctx.fillText(v+'x',3,y+3);}});}

loadState();renderSports('soccer');updateBal();
</script>
