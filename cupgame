<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>Cup Casino</title>
<link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@400;600;700&family=Orbitron:wght@400;700;900&family=Inter:wght@300;400;500;600&family=Bebas+Neue&display=swap" rel="stylesheet"/>
<style>
*{box-sizing:border-box;margin:0;padding:0}
:root{
  --g:#00ff88;--g2:#00cc66;--g3:#00ff8840;
  --red:#ff3355;--gold:#ffd700;--blue:#4488ff;--purple:#aa44ff;--orange:#ff8822;
  --bg:#06080b;--bg2:#0b0f16;--bg3:#101520;--bg4:#151c27;--bg5:#1a2232;
  --txt:#c0d8cc;--txt2:#4a7060;--txt3:#7a9a8a;
  --border:#1a2a38;--border2:#243550;
  --fd:'Orbitron',sans-serif;--fb:'Inter',sans-serif;--fu:'Rajdhani',sans-serif;--fh:'Bebas Neue',sans-serif;
  --modal-w:min(95vw,700px);
}
body{background:var(--bg);color:var(--txt);font-family:var(--fb);font-size:13px;overflow:hidden;height:100vh}
.app{display:flex;height:100vh;overflow:hidden}

/* ===== SIDEBAR ===== */
.sidebar{width:200px;flex-shrink:0;background:var(--bg2);border-right:1px solid var(--border);display:flex;flex-direction:column;overflow-y:auto}
.logo{padding:16px 12px 12px;display:flex;align-items:center;gap:10px;border-bottom:1px solid var(--border)}
.logo-icon{width:36px;height:36px;background:linear-gradient(135deg,var(--g),var(--g2));border-radius:8px;display:flex;align-items:center;justify-content:center;flex-shrink:0;overflow:hidden}
.logo-svg{width:24px;height:24px}
.logo-text{font-family:var(--fh);font-size:22px;letter-spacing:2px;color:var(--g);line-height:1}
.logo-sub{font-size:9px;color:var(--txt2);letter-spacing:3px;font-family:var(--fu)}
.sb-sec{padding:14px 12px 3px;font-size:9px;font-weight:700;color:var(--txt2);letter-spacing:2px;text-transform:uppercase;font-family:var(--fu)}
.sb-item{display:flex;align-items:center;gap:9px;padding:8px 12px;color:var(--txt2);cursor:pointer;font-size:13px;font-family:var(--fu);font-weight:600;border-left:2px solid transparent;transition:all .15s;position:relative}
.sb-item:hover{background:var(--bg3);color:var(--txt)}
.sb-item.active{background:var(--bg3);color:var(--g);border-left-color:var(--g)}
.sb-ico{width:20px;height:20px;flex-shrink:0;display:flex;align-items:center;justify-content:center}
.sb-ico svg{width:16px;height:16px;fill:currentColor}
.sb-badge{margin-left:auto;font-size:8px;padding:2px 5px;border-radius:6px;font-weight:700;font-family:var(--fu)}
.sb-badge.hot{background:#ff335522;color:var(--red)}
.sb-badge.new{background:#00ff8822;color:var(--g)}
.sb-badge.live{background:#4488ff22;color:var(--blue)}
.user-panel{padding:8px;border-top:1px solid var(--border);margin-top:auto}
.user-info{display:flex;align-items:center;gap:8px;background:var(--bg3);border-radius:9px;padding:8px;cursor:pointer;border:1px solid var(--border);transition:border-color .15s}
.user-info:hover{border-color:var(--g)}
.user-avatar{width:28px;height:28px;border-radius:50%;background:linear-gradient(135deg,var(--g),var(--g2));display:flex;align-items:center;justify-content:center;color:#06080b;font-weight:700;font-family:var(--fh);font-size:13px;flex-shrink:0}
.user-name{font-weight:600;font-family:var(--fu);font-size:12px;color:#fff}
.user-bal{font-size:11px;color:var(--g);font-weight:700}

/* ===== MAIN ===== */
.main{flex:1;display:flex;flex-direction:column;overflow:hidden}
.topbar{display:flex;align-items:center;gap:10px;background:var(--bg2);border-bottom:1px solid var(--border);padding:0 14px;height:46px;flex-shrink:0}
.search-bar{background:var(--bg3);border:1px solid var(--border);border-radius:18px;padding:6px 14px 6px 32px;color:var(--txt);font-size:12px;outline:none;width:170px;position:relative}
.search-wrap{position:relative}
.search-wrap svg{position:absolute;left:10px;top:50%;transform:translateY(-50%);width:13px;height:13px;fill:var(--txt2);pointer-events:none}
.search-bar:focus{border-color:var(--g)}
.search-bar::placeholder{color:var(--txt2)}
.topbar-right{display:flex;align-items:center;gap:7px;margin-left:auto}
.bal-pill{background:var(--bg3);border:1px solid var(--border);border-radius:18px;padding:5px 12px;display:flex;align-items:center;gap:6px;font-size:12px}
.bal-amt{color:var(--g);font-weight:700;font-size:13px;font-family:var(--fd)}
.btn{border:none;border-radius:6px;padding:6px 13px;font-size:12px;font-weight:700;cursor:pointer;font-family:var(--fu);transition:all .15s;letter-spacing:.5px}
.btn-outline{background:transparent;border:1px solid var(--border);color:var(--txt)}
.btn-outline:hover{border-color:var(--g);color:var(--g)}
.btn-primary{background:linear-gradient(135deg,var(--g),var(--g2));color:#06080b}
.btn-primary:hover{filter:brightness(1.1)}

/* ===== PAGES ===== */
.page{display:none;flex:1;overflow-y:auto;flex-direction:column}
.page.active{display:flex}

/* ===== HOME ===== */
.hero{background:linear-gradient(160deg,#0b1e14 0%,#08141e 60%,#0a0c14 100%);padding:18px 20px;border-bottom:1px solid var(--border);position:relative;overflow:hidden;flex-shrink:0}
.hero::before{content:'';position:absolute;top:-40%;right:-5%;width:300px;height:300px;background:radial-gradient(circle,#00ff8810 0%,transparent 70%);pointer-events:none}
.hero h2{font-family:var(--fh);font-size:26px;color:#fff;letter-spacing:2px;margin-bottom:2px}
.hero p{font-size:11px;color:var(--txt3)}
.hero-stats{display:flex;gap:9px;margin-top:12px;flex-wrap:wrap}
.hstat{background:var(--bg4);border:1px solid var(--border);border-radius:9px;padding:8px 13px;min-width:90px}
.hstat-val{font-family:var(--fd);font-size:15px;font-weight:700;color:var(--g)}
.hstat-val.red{color:var(--red)}
.hstat-lbl{font-size:9px;color:var(--txt2);margin-top:1px;font-family:var(--fu);letter-spacing:.5px}

/* Stakes selector */
.stakes-bar{display:flex;align-items:center;gap:7px;padding:8px 14px;background:var(--bg2);border-bottom:1px solid var(--border);overflow-x:auto;flex-shrink:0}
.stakes-lbl{font-size:10px;color:var(--txt2);font-family:var(--fu);font-weight:700;white-space:nowrap}
.stake-btn{padding:4px 11px;border-radius:12px;font-size:11px;font-weight:700;cursor:pointer;border:1px solid var(--border);color:var(--txt2);font-family:var(--fu);transition:all .15s;white-space:nowrap;background:transparent}
.stake-btn:hover{color:var(--txt);border-color:var(--txt2)}
.stake-btn.active{border-color:var(--g);color:var(--g);background:#00ff8812}
.stake-btn[data-s="poor"]{border-color:#4a7060}
.stake-btn[data-s="middle"]{border-color:#4488ff55}
.stake-btn[data-s="middle"].active,.stake-btn[data-s="middle"]:hover{color:var(--gold);border-color:var(--gold);background:#ffd70010}
.stake-btn[data-s="millionaire"].active,.stake-btn[data-s="millionaire"]:hover{color:#ff8822;border-color:#ff8822;background:#ff882210}
.stake-btn[data-s="billionaire"].active,.stake-btn[data-s="billionaire"]:hover{color:#aa44ff;border-color:#aa44ff;background:#aa44ff10}

.cat-tabs{display:flex;gap:2px;padding:7px 13px 0;background:var(--bg2);border-bottom:1px solid var(--border);overflow-x:auto;flex-shrink:0}
.cat-tab{padding:6px 13px;border-radius:4px 4px 0 0;font-size:12px;font-weight:600;color:var(--txt2);cursor:pointer;white-space:nowrap;border-bottom:2px solid transparent;font-family:var(--fu);transition:all .15s}
.cat-tab:hover{color:var(--txt)}
.cat-tab.active{color:var(--g);border-bottom-color:var(--g)}
.content-area{display:flex;flex:1;overflow:hidden}
.feed-panel{flex:1;padding:14px;overflow-y:auto}
.live-panel{width:190px;background:var(--bg2);border-left:1px solid var(--border);padding:10px;flex-shrink:0;overflow-y:auto}
.sec-hdr{display:flex;align-items:center;justify-content:space-between;margin-bottom:9px}
.sec-hdr h3{font-family:var(--fd);font-size:11px;font-weight:700;color:#fff;letter-spacing:.5px}
.see-all{font-size:11px;color:var(--g);cursor:pointer;font-family:var(--fu)}
.games-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-bottom:20px}
.game-card{background:var(--bg3);border-radius:10px;overflow:hidden;cursor:pointer;border:1px solid var(--border);transition:all .2s}
.game-card:hover{border-color:var(--g);transform:translateY(-3px);box-shadow:0 8px 24px rgba(0,255,136,.08)}
.game-thumb{width:100%;aspect-ratio:4/3;display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden}
.game-badge{position:absolute;top:5px;left:5px;font-size:8px;font-weight:700;padding:2px 5px;border-radius:3px;font-family:var(--fu);z-index:2;letter-spacing:.5px}
.badge-hot{background:var(--red);color:#fff}
.badge-new{background:var(--g);color:#06080b}
.badge-live{background:var(--blue);color:#fff}
.game-info{padding:6px 7px 7px}
.game-name{font-size:11px;font-weight:600;color:#fff;font-family:var(--fu)}
.game-sub{font-size:9px;color:var(--txt2);margin-top:1px}
.thumb-canvas{width:100%;height:100%;display:block}

/* ===== LIVE BETS ===== */
.live-hdr{font-size:11px;font-weight:700;color:#fff;margin-bottom:8px;display:flex;align-items:center;gap:5px;font-family:var(--fd)}
.live-dot{width:6px;height:6px;border-radius:50%;background:var(--red);animation:ldot 1s infinite}
@keyframes ldot{0%,100%{opacity:1}50%{opacity:.3}}
.bet-row{display:flex;align-items:center;gap:5px;padding:5px 0;border-bottom:1px solid var(--border);animation:fadeInBet .3s ease}
@keyframes fadeInBet{from{opacity:0;transform:translateY(-3px)}to{opacity:1;transform:translateY(0)}}
.bet-av{width:22px;height:22px;border-radius:50%;background:var(--bg4);display:flex;align-items:center;justify-content:center;font-size:8px;color:var(--g);font-weight:700;font-family:var(--fh);flex-shrink:0}
.bet-info{flex:1;min-width:0}
.bet-user{font-size:10px;color:var(--txt);font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-family:var(--fu)}
.bet-game{font-size:9px;color:var(--txt2);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.bet-amt{font-size:10px;font-weight:700;white-space:nowrap;font-family:var(--fd)}
.bet-amt.g{color:var(--g)}.bet-amt.r{color:var(--red)}

/* ===== SPORTS ===== */
.sports-hero{background:linear-gradient(135deg,#0a1520 0%,#0d1a30 100%);padding:16px 18px;border-bottom:1px solid var(--border);flex-shrink:0}
.sports-hero h2{font-family:var(--fh);font-size:22px;color:#fff;letter-spacing:2px}
.sport-tabs{display:flex;gap:5px;padding:9px 13px;overflow-x:auto;background:var(--bg2);border-bottom:1px solid var(--border);flex-shrink:0}
.sport-tab{display:flex;align-items:center;gap:5px;padding:5px 13px;border-radius:16px;font-size:12px;font-weight:600;cursor:pointer;white-space:nowrap;font-family:var(--fu);border:1px solid var(--border);color:var(--txt2);transition:all .15s}
.sport-tab svg{width:13px;height:13px;fill:currentColor}
.sport-tab:hover{color:var(--txt);border-color:var(--txt2)}
.sport-tab.active{background:var(--g);color:#06080b;border-color:var(--g)}
.sports-layout{display:flex;flex:1;overflow:hidden}
.sports-main{flex:1;overflow-y:auto;padding:13px}
.match-card{background:var(--bg3);border:1px solid var(--border);border-radius:10px;padding:12px;margin-bottom:8px;transition:border-color .15s}
.match-card:hover{border-color:var(--border2)}
.match-league{font-size:10px;color:var(--txt2);font-family:var(--fu);font-weight:600;letter-spacing:.5px;margin-bottom:6px;display:flex;align-items:center;gap:5px}
.match-live-pill{background:#ff335522;color:var(--red);font-size:8px;padding:2px 5px;border-radius:5px;font-weight:700}
.match-teams{display:flex;align-items:center;justify-content:space-between;gap:7px}
.match-team{display:flex;flex-direction:column;align-items:center;gap:3px;flex:1}
.team-badge{width:32px;height:32px;border-radius:6px;display:flex;align-items:center;justify-content:center;font-size:18px;background:var(--bg4);border:1px solid var(--border)}
.team-name{font-size:11px;font-weight:700;color:#fff;text-align:center;font-family:var(--fu)}
.team-score{font-family:var(--fd);font-size:18px;font-weight:900;color:var(--g)}
.match-vs{font-family:var(--fd);font-size:11px;color:var(--txt2);padding:0 5px;text-align:center}
.match-time{font-size:10px;color:var(--txt2);font-family:var(--fu)}
.match-odds{display:flex;gap:4px;margin-top:9px}
.odd-btn{flex:1;background:var(--bg4);border:1px solid var(--border);border-radius:6px;padding:6px;text-align:center;cursor:pointer;transition:all .15s}
.odd-btn:hover,.odd-btn.sel{border-color:var(--g);background:#00ff8812}
.odd-label{font-size:9px;color:var(--txt2);font-family:var(--fu);font-weight:600}
.odd-val{font-family:var(--fd);font-size:12px;font-weight:700;color:#fff;margin-top:1px}
.bet-slip{background:var(--bg2);border-left:1px solid var(--border);width:200px;flex-shrink:0;padding:12px;overflow-y:auto;display:flex;flex-direction:column}
.bet-slip h4{font-family:var(--fd);font-size:10px;color:#fff;margin-bottom:9px;letter-spacing:.5px}
.bet-slip-empty{color:var(--txt2);font-size:11px;text-align:center;margin-top:20px;font-family:var(--fu)}
.bsi{background:var(--bg3);border:1px solid var(--border);border-radius:6px;padding:8px;margin-bottom:6px;position:relative}
.bsi-teams{font-size:11px;font-weight:600;color:#fff;font-family:var(--fu);margin-bottom:2px;padding-right:36px}
.bsi-pick{font-size:10px;color:var(--g)}
.bsi-odd{font-family:var(--fd);font-size:12px;font-weight:700;color:var(--gold);position:absolute;top:8px;right:8px}
.bsi-rm{position:absolute;bottom:8px;right:8px;background:none;border:none;color:var(--txt2);cursor:pointer;font-size:11px}
.bsi-rm:hover{color:var(--red)}
.bet-total{display:flex;justify-content:space-between;margin:6px 0;font-size:11px;color:var(--txt2);font-family:var(--fu)}
.bet-total b{color:var(--g);font-family:var(--fd)}
.divider{height:1px;background:var(--border);margin:8px 0}

/* ===== PROFILE ===== */
.profile-page{padding:20px;overflow-y:auto}
.prof-hdr{display:flex;align-items:center;gap:16px;background:var(--bg3);border:1px solid var(--border);border-radius:12px;padding:18px;margin-bottom:14px}
.prof-av{width:60px;height:60px;border-radius:50%;background:linear-gradient(135deg,var(--g),var(--g2));display:flex;align-items:center;justify-content:center;font-family:var(--fh);font-size:24px;color:#06080b;flex-shrink:0;border:3px solid var(--g2)}
.prof-details h2{font-family:var(--fh);font-size:22px;color:#fff;letter-spacing:1px}
.prof-since{font-size:11px;color:var(--txt2);margin-top:2px;font-family:var(--fu)}
.prof-level{display:inline-flex;align-items:center;gap:5px;background:#ffd70018;border:1px solid var(--gold);border-radius:16px;padding:2px 9px;font-size:11px;color:var(--gold);font-family:var(--fu);font-weight:700;margin-top:6px}
.stat-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:9px;margin-bottom:14px}
.stat-card{background:var(--bg3);border:1px solid var(--border);border-radius:10px;padding:12px}
.stat-val{font-family:var(--fd);font-size:18px;font-weight:700;color:var(--g)}
.stat-val.red{color:var(--red)}.stat-val.gold{color:var(--gold)}
.stat-lbl{font-size:9px;color:var(--txt2);margin-top:2px;font-family:var(--fu);font-weight:600}
.prof-section{background:var(--bg3);border:1px solid var(--border);border-radius:10px;padding:13px;margin-bottom:12px}
.prof-section h3{font-family:var(--fd);font-size:11px;color:#fff;margin-bottom:9px}
.hist-row{display:flex;align-items:center;justify-content:space-between;padding:6px 0;border-bottom:1px solid var(--border);font-size:12px}
.hist-row:last-child{border-bottom:none}
.hist-game{color:var(--txt);font-family:var(--fu);font-weight:600}
.hist-time{color:var(--txt2);font-size:10px}
.hist-amt.win{color:var(--g);font-family:var(--fd);font-weight:700}
.hist-amt.lose{color:var(--red);font-family:var(--fd);font-weight:700}

/* ===== PROMOS ===== */
.promos-page{padding:20px;overflow-y:auto}
.promos-page h2{font-family:var(--fh);font-size:24px;color:#fff;letter-spacing:2px;margin-bottom:16px}
.promo-card{background:var(--bg3);border:1px solid var(--border);border-radius:12px;padding:16px;margin-bottom:10px;display:flex;align-items:center;gap:13px}
.promo-icon{width:44px;height:44px;flex-shrink:0;background:var(--bg4);border-radius:10px;display:flex;align-items:center;justify-content:center}
.promo-icon svg{width:26px;height:26px}
.promo-info{flex:1}
.promo-title{font-family:var(--fd);font-size:13px;color:#fff;margin-bottom:2px}
.promo-desc{font-size:11px;color:var(--txt3);line-height:1.5}
.promo-code{background:var(--bg4);border:1px dashed var(--g);border-radius:6px;padding:6px 11px;font-family:var(--fd);font-size:12px;color:var(--g);letter-spacing:2px;cursor:pointer;flex-shrink:0}
.promo-code:hover{background:#00ff8811}
.promo-redeem{background:var(--bg3);border:1px solid var(--border);border-radius:12px;padding:16px;margin-top:18px}
.promo-redeem h3{font-family:var(--fd);font-size:12px;color:#fff;margin-bottom:11px}
.promo-row{display:flex;gap:7px}
.promo-in{background:var(--bg);border:1px solid var(--border);border-radius:6px;padding:8px 11px;color:#fff;font-size:13px;flex:1;outline:none}
.promo-in:focus{border-color:var(--g)}

/* ===== FULLSCREEN MODAL ===== */
.modal-wrap{display:none;background:rgba(0,0,0,.88);position:fixed;inset:0;z-index:300;align-items:center;justify-content:center;backdrop-filter:blur(6px)}
.modal-wrap.open{display:flex}
.modal{background:var(--bg2);border:1px solid var(--border);border-radius:14px;padding:0;width:min(96vw,820px);max-height:92vh;overflow:hidden;position:relative;box-shadow:0 24px 80px rgba(0,0,0,.8);display:flex;flex-direction:column}
.modal-header{padding:16px 20px;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:12px;flex-shrink:0}
.modal-header h3{font-family:var(--fh);color:var(--g);font-size:20px;font-weight:400;letter-spacing:2px;flex:1}
.modal-close{background:none;border:none;color:var(--txt2);font-size:18px;cursor:pointer;line-height:1;padding:4px 8px;border-radius:5px;transition:all .15s}
.modal-close:hover{color:#fff;background:var(--bg3)}
.modal-body{padding:18px 20px;overflow-y:auto;flex:1}

/* ===== GAME ELEMENTS ===== */
.field-row{display:flex;align-items:center;gap:8px;margin-bottom:9px}
.field-label{color:var(--txt2);font-size:12px;width:46px;flex-shrink:0;font-family:var(--fu)}
.field-input{background:var(--bg);border:1px solid var(--border);border-radius:6px;padding:7px 10px;color:#fff;font-size:14px;flex:1;outline:none;font-family:var(--fd)}
.field-input:focus{border-color:var(--g)}
.quick-row{display:flex;gap:4px;margin-bottom:10px;flex-wrap:wrap}
.qb{background:var(--bg);border:1px solid var(--border);border-radius:4px;padding:4px 9px;font-size:11px;color:var(--txt2);cursor:pointer;font-family:var(--fu);font-weight:600;transition:all .15s}
.qb:hover{border-color:var(--g);color:var(--g)}
.bet-type-row{display:flex;gap:4px;margin-bottom:10px;flex-wrap:wrap}
.bt{background:var(--bg);border:1px solid var(--border);border-radius:4px;padding:5px 10px;font-size:11px;color:var(--txt2);cursor:pointer;font-family:var(--fu);font-weight:600;transition:all .15s}
.bt:hover,.bt.sel{border-color:var(--g);color:var(--g);background:#00ff8810}
.play-btn{width:100%;background:linear-gradient(135deg,var(--g),var(--g2));color:#06080b;border:none;border-radius:8px;padding:11px;font-size:14px;font-weight:700;cursor:pointer;margin-top:5px;font-family:var(--fh);letter-spacing:1px;transition:all .15s}
.play-btn:hover{filter:brightness(1.1);transform:translateY(-1px)}
.play-btn:disabled{background:var(--border);color:var(--txt2);cursor:not-allowed;transform:none;filter:none}
.result-box{margin-top:10px;padding:10px 13px;border-radius:8px;font-size:13px;font-weight:600;text-align:center;display:none;font-family:var(--fd);letter-spacing:.5px}
.result-box.show{display:block;animation:popIn .3s ease}
@keyframes popIn{from{transform:scale(.92);opacity:0}to{transform:scale(1);opacity:1}}
.result-box.win{background:#00ff8815;border:1px solid #00ff8840;color:var(--g)}
.result-box.lose{background:#ff335515;border:1px solid #ff335540;color:var(--red)}

/* ===== CARD VISUALS ===== */
.card-row{display:flex;gap:5px;justify-content:center;margin:9px 0;flex-wrap:wrap}
.pcard{width:44px;height:62px;background:#fff;border-radius:6px;display:flex;flex-direction:column;align-items:center;justify-content:center;font-size:16px;font-weight:700;border:1px solid #ccc;box-shadow:0 2px 10px rgba(0,0,0,.4);animation:flip .3s ease;flex-shrink:0}
@keyframes flip{from{transform:rotateY(90deg)}to{transform:rotateY(0)}}
.pcard.red{color:#cc2200}.pcard.black{color:#111}
.pcard.back{background:linear-gradient(135deg,#1a3a6a,#0a1a40);color:#4488ff;font-size:22px}

/* ===== CRASH ===== */
.crash-chart-inner{position:relative;margin-bottom:10px}
.crash-mult{font-family:var(--fh);font-size:52px;font-weight:400;letter-spacing:3px;text-align:center;color:var(--g);transition:color .3s;position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);text-shadow:0 0 30px currentColor;pointer-events:none}
.crash-mult.crashed{color:var(--red)}

/* ===== SLOTS ===== */
.slots-window{display:flex;gap:8px;justify-content:center;margin:14px 0;background:rgba(0,0,0,.4);border:2px solid var(--border);border-radius:12px;padding:12px}
.slot-reel{width:86px;height:90px;overflow:hidden;border-radius:8px;border:1px solid var(--border);background:#08090f;position:relative}
.slot-reel::before,.slot-reel::after{content:'';position:absolute;left:0;right:0;height:22px;z-index:2;pointer-events:none}
.slot-reel::before{top:0;background:linear-gradient(to bottom,#08090f,transparent)}
.slot-reel::after{bottom:0;background:linear-gradient(to top,#08090f,transparent)}
.slot-strip{display:flex;flex-direction:column;align-items:center;transition:transform .5s cubic-bezier(.25,.46,.45,.94)}
.slot-strip .slot-sym{font-size:38px;height:90px;display:flex;align-items:center;justify-content:center;width:100%}
.slot-label{text-align:center;font-size:9px;color:var(--txt2);font-family:var(--fu);letter-spacing:1px;margin-bottom:2px}
/* Lightning animation for Olympus */
.lightning-overlay{position:absolute;top:0;left:0;right:0;bottom:0;pointer-events:none;z-index:10;display:none}
.lightning-overlay.strike{display:block;animation:lightningStrike .6s ease forwards}
@keyframes lightningStrike{0%{opacity:0}10%{opacity:1;background:radial-gradient(ellipse at 50% 30%,rgba(255,215,0,.4) 0%,transparent 70%)}20%{opacity:.3}30%{opacity:.9;background:radial-gradient(ellipse at 40% 50%,rgba(255,215,0,.5) 0%,transparent 60%)}50%{opacity:.5}70%{opacity:0}100%{opacity:0}}

/* ===== MINES ===== */
.mines-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:5px;margin:10px 0}
.mine-cell{height:48px;background:var(--bg);border:1px solid var(--border);border-radius:7px;display:flex;align-items:center;justify-content:center;font-size:20px;cursor:pointer;transition:all .15s;position:relative;overflow:hidden}
.mine-cell:hover:not(.rev){border-color:var(--g);background:#00ff8812;transform:scale(1.04)}
.mine-cell.safe{background:#00ff8812;border-color:var(--g);animation:safePop .2s ease}
@keyframes safePop{0%{transform:scale(.8)}100%{transform:scale(1)}}
.mine-cell.boom{background:#ff335512;border-color:var(--red);animation:shake .3s ease}
@keyframes shake{0%,100%{transform:translateX(0)}25%{transform:translateX(-4px)}75%{transform:translateX(4px)}}
.mines-info-row{display:flex;align-items:center;gap:9px;margin-bottom:7px;flex-wrap:wrap}
.mines-mult{font-family:var(--fd);color:var(--g);font-size:17px;font-weight:700}
.cashout-btn{background:var(--gold);color:#06080b;border:none;border-radius:6px;padding:6px 12px;font-size:12px;font-weight:700;cursor:pointer;font-family:var(--fh);letter-spacing:.5px;transition:all .15s}
.cashout-btn:hover{filter:brightness(1.1)}
.cashout-btn:disabled{background:var(--border);color:var(--txt2);cursor:not-allowed}

/* ===== PLINKO ===== */
#plinko-canvas{display:block;border-radius:8px;border:1px solid var(--border)}
.plinko-modes{display:flex;gap:4px;margin-bottom:9px;flex-wrap:wrap}
.pm{background:var(--bg);border:1px solid var(--border);border-radius:4px;padding:5px 10px;font-size:11px;color:var(--txt2);cursor:pointer;font-family:var(--fu);font-weight:600;transition:all .15s}
.pm:hover,.pm.sel{border-color:var(--g);color:var(--g);background:#00ff8810}
.plinko-result-row{text-align:center;font-family:var(--fd);font-size:17px;color:var(--g);margin:5px 0;min-height:26px}

/* ===== BLACKJACK ===== */
.bj-layout{display:flex;gap:14px}
.bj-game{flex:1}
.bj-sidebets{width:160px;flex-shrink:0}
.bj-sidebet-title{font-family:var(--fd);font-size:10px;color:var(--gold);margin-bottom:7px;letter-spacing:.5px}
.bj-sidebet-card{background:var(--bg4);border:1px solid var(--border);border-radius:8px;padding:9px;margin-bottom:6px;cursor:pointer;transition:all .15s}
.bj-sidebet-card:hover,.bj-sidebet-card.sel{border-color:var(--gold);background:#ffd70010}
.bj-sidebet-name{font-size:11px;font-weight:700;color:#fff;font-family:var(--fu)}
.bj-sidebet-desc{font-size:10px;color:var(--txt2);margin-top:2px;line-height:1.3}
.bj-sidebet-odds{font-family:var(--fd);font-size:12px;color:var(--gold);margin-top:3px}
.bj-table{background:radial-gradient(ellipse at center,#0c3a16 0%,#071508 100%);border-radius:50% / 28%;padding:16px 18px;margin:7px 0;border:2px solid #1a5a20;position:relative;min-height:80px}
.bj-label{font-size:9px;color:#2a7a28;font-family:var(--fu);font-weight:600;text-align:center;margin:3px 0;letter-spacing:1px}
.bj-score{text-align:center;font-size:11px;color:#3a8a38;margin:2px 0;font-family:var(--fu)}
.bj-actions{display:flex;gap:5px;margin:7px 0}
.bj-btn{flex:1;background:var(--bg3);border:1px solid var(--border);border-radius:6px;padding:7px;font-size:12px;font-weight:700;cursor:pointer;color:var(--txt);font-family:var(--fu);transition:all .15s}
.bj-btn:hover:not(:disabled){border-color:var(--g);color:var(--g)}
.bj-btn:disabled{opacity:.35;cursor:not-allowed}

/* ===== POKER ===== */
.poker-table{background:radial-gradient(ellipse at center,#0c2a3c 0%,#05101a 100%);border-radius:50% / 28%;padding:14px 16px;margin:7px 0;border:2px solid #1a3860;position:relative;min-height:80px}
.poker-label{font-size:9px;color:#2a5a7a;font-family:var(--fu);font-weight:600;text-align:center;margin:3px 0;letter-spacing:1px}
.poker-pot{text-align:center;font-family:var(--fd);font-size:12px;color:var(--gold);margin:3px 0}
.poker-actions{display:flex;gap:4px;flex-wrap:wrap;margin:7px 0}
.poker-btn{flex:1;background:var(--bg3);border:1px solid var(--border);border-radius:6px;padding:7px;font-size:11px;font-weight:700;cursor:pointer;color:var(--txt);font-family:var(--fu);min-width:55px;transition:all .15s}
.poker-btn:hover:not(:disabled){border-color:var(--blue);color:var(--blue)}
.poker-btn:disabled{opacity:.35;cursor:not-allowed}
.poker-btn.fold:hover:not(:disabled){border-color:var(--red);color:var(--red)}
.poker-btn.raise:hover:not(:disabled){border-color:var(--gold);color:var(--gold)}
.poker-stage{text-align:center;font-size:11px;color:var(--txt2);font-family:var(--fu);margin:3px 0}
.hand-rank{text-align:center;font-family:var(--fd);font-size:12px;color:var(--gold);margin:4px 0;min-height:20px}

/* ===== BACCARAT ===== */
.bac-layout{display:flex;gap:14px}
.bac-game{flex:1}
.bac-sidebets{width:155px;flex-shrink:0}
.bac-table{background:radial-gradient(ellipse at center,#1c0830 0%,#080512 100%);border-radius:50% / 28%;padding:14px 16px;margin:7px 0;border:2px solid #3a1858;position:relative;min-height:80px}
.bac-label{font-size:9px;color:#5a2a8a;font-family:var(--fu);font-weight:600;text-align:center;margin:3px 0;letter-spacing:1px}
.bac-score{text-align:center;font-family:var(--fd);font-size:24px;font-weight:900;color:var(--purple);margin:2px 0}

/* ===== ROULETTE ===== */
.roulette-layout{display:flex;gap:16px;flex-direction:column}
.roulette-top{display:flex;gap:16px;align-items:flex-start}
.roulette-wheel-wrap{position:relative;flex-shrink:0}
.roulette-info{flex:1}
.roulette-result-big{font-family:var(--fh);font-size:44px;color:var(--g);text-align:center;min-height:56px;letter-spacing:2px;margin-bottom:5px}
.roulette-result-big.red{color:var(--red)}.roulette-result-big.black{color:#aaa}.roulette-result-big.green{color:var(--g)}
.roulette-recent{display:flex;gap:4px;flex-wrap:wrap;margin-bottom:10px}
.rr-num{width:24px;height:24px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:9px;font-weight:700;font-family:var(--fd);flex-shrink:0}
.rr-num.red{background:#cc2200}.rr-num.black{background:#222;border:1px solid #444}.rr-num.green{background:#00aa33}
/* Roulette table */
.rou-table{width:100%;border-collapse:collapse;margin-top:8px}
.rou-table td{border:1px solid var(--border2);text-align:center;cursor:pointer;padding:5px 3px;font-family:var(--fd);font-size:10px;font-weight:700;color:#fff;transition:all .15s;min-width:22px}
.rou-table td:hover{filter:brightness(1.4);transform:scale(1.05)}
.rou-table td.sel{outline:2px solid var(--gold);outline-offset:1px}
.rou-td-red{background:#cc220088}
.rou-td-black{background:#22222288}
.rou-td-green{background:#00aa3388}
.rou-side-bets{display:flex;gap:4px;flex-wrap:wrap;margin-top:8px}
.rou-side{flex:1;background:var(--bg4);border:1px solid var(--border);border-radius:5px;padding:6px 4px;text-align:center;cursor:pointer;transition:all .15s;min-width:50px}
.rou-side:hover,.rou-side.sel{border-color:var(--g);background:#00ff8812}
.rou-side-label{font-size:9px;font-weight:700;color:var(--txt2);font-family:var(--fu)}
.rou-side-odds{font-family:var(--fd);font-size:11px;color:#fff;margin-top:1px}

/* ===== KENO ===== */
.keno-grid{display:grid;grid-template-columns:repeat(10,1fr);gap:3px;margin:10px 0}
.keno-cell{height:34px;background:var(--bg);border:1px solid var(--border);border-radius:4px;display:flex;align-items:center;justify-content:center;font-family:var(--fd);font-size:11px;font-weight:700;cursor:pointer;transition:all .15s;color:var(--txt2)}
.keno-cell:hover:not(.drawn){border-color:var(--blue);color:var(--blue)}
.keno-cell.picked{background:#4488ff22;border-color:var(--blue);color:var(--blue)}
.keno-cell.hit{background:#00ff8822;border-color:var(--g);color:var(--g);animation:kenoPop .3s ease}
.keno-cell.miss{background:#33333322;border-color:#333;color:#555}
@keyframes kenoPop{0%{transform:scale(1.3)}100%{transform:scale(1)}}
.keno-info{display:flex;gap:8px;margin-bottom:8px;font-family:var(--fu);font-size:11px;color:var(--txt2)}
.keno-info b{color:var(--g)}

/* ===== WHEEL OF FORTUNE ===== */
.wheel-wrap{position:relative;width:260px;height:260px;margin:0 auto}
#wof-canvas{display:block;border-radius:50%;border:3px solid var(--border2)}
.wof-pointer{position:absolute;top:-12px;left:50%;transform:translateX(-50%);width:0;height:0;border-left:10px solid transparent;border-right:10px solid transparent;border-top:22px solid var(--gold);filter:drop-shadow(0 2px 8px rgba(255,215,0,.5))}
.wof-result{text-align:center;font-family:var(--fh);font-size:36px;color:var(--gold);margin:8px 0;min-height:44px;letter-spacing:2px}

/* ===== DICE (enhanced) ===== */
.dice-3d-wrap{display:flex;gap:14px;justify-content:center;margin:14px 0}
.dice-face{width:72px;height:72px;background:linear-gradient(135deg,#f5f5f5,#e0e0e0);border-radius:12px;box-shadow:3px 3px 0 #aaa,0 6px 20px rgba(0,0,0,.5);display:flex;align-items:center;justify-content:center;position:relative;transition:transform .2s}
.dice-face.rolling{animation:diceRoll .08s infinite}
@keyframes diceRoll{0%{transform:rotate(-3deg) scale(1.02)}50%{transform:rotate(3deg) scale(.98)}100%{transform:rotate(-3deg) scale(1.02)}}

/* ===== VIDEO POKER ===== */
.vp-cards{display:flex;gap:6px;justify-content:center;margin:10px 0}
.vp-card-wrap{display:flex;flex-direction:column;align-items:center;gap:4px}
.vp-hold{font-size:9px;font-family:var(--fu);font-weight:700;color:var(--gold);opacity:0;transition:opacity .2s;padding:2px 6px;background:#ffd70020;border:1px solid var(--gold);border-radius:3px}
.vp-hold.held{opacity:1}
.vp-pcard{width:52px;height:72px;background:#fff;border-radius:6px;display:flex;flex-direction:column;align-items:center;justify-content:center;font-size:17px;font-weight:700;border:1px solid #ccc;box-shadow:0 2px 10px rgba(0,0,0,.4);cursor:pointer;transition:all .15s;flex-shrink:0}
.vp-pcard.red{color:#cc2200}.vp-pcard.black{color:#111}
.vp-pcard.held-card{border:2px solid var(--gold);box-shadow:0 0 12px rgba(255,215,0,.4)}
.vp-pcard.back{background:linear-gradient(135deg,#1a3a6a,#0a1a40);color:#4488ff;font-size:22px}
.vp-paytable{background:var(--bg4);border:1px solid var(--border);border-radius:8px;padding:10px;margin-bottom:10px}
.vp-pt-row{display:flex;justify-content:space-between;padding:3px 0;border-bottom:1px solid var(--border);font-size:11px;font-family:var(--fu)}
.vp-pt-row:last-child{border-bottom:none}
.vp-pt-hand{color:var(--txt)}
.vp-pt-pay{color:var(--gold);font-family:var(--fd)}

/* ===== AUTH ===== */
.auth-tabs{display:flex;gap:0;margin-bottom:16px;border-bottom:1px solid var(--border)}
.auth-tab{flex:1;padding:9px;text-align:center;cursor:pointer;font-family:var(--fu);font-weight:700;color:var(--txt2);border-bottom:2px solid transparent;margin-bottom:-1px;transition:all .15s}
.auth-tab.active{color:var(--g);border-bottom-color:var(--g)}
.auth-form{display:flex;flex-direction:column;gap:8px}
.auth-input{background:var(--bg);border:1px solid var(--border);border-radius:6px;padding:9px 11px;color:#fff;font-size:14px;outline:none;width:100%}
.auth-input:focus{border-color:var(--g)}
.auth-btn{background:linear-gradient(135deg,var(--g),var(--g2));color:#06080b;border:none;border-radius:7px;padding:11px;font-size:14px;font-weight:700;cursor:pointer;font-family:var(--fh);letter-spacing:1px;width:100%;margin-top:3px;transition:all .15s}
.auth-btn:hover{filter:brightness(1.1)}

/* ===== AUTH MODAL ===== */
.auth-modal-inner{background:var(--bg2);border:1px solid var(--border);border-radius:13px;padding:22px;width:340px;max-width:95vw;position:relative;box-shadow:0 20px 60px rgba(0,0,0,.7)}
.auth-modal-close{position:absolute;top:12px;right:13px;background:none;border:none;color:var(--txt2);font-size:18px;cursor:pointer;line-height:1}
.auth-modal-close:hover{color:#fff}

/* ===== TOAST ===== */
.toast{position:fixed;bottom:20px;left:50%;transform:translateX(-50%);background:linear-gradient(135deg,var(--g),var(--g2));color:#06080b;padding:9px 20px;border-radius:24px;font-size:13px;font-weight:700;z-index:500;display:none;white-space:nowrap;font-family:var(--fh);letter-spacing:.5px;box-shadow:0 4px 20px rgba(0,255,136,.3)}
.toast.show{display:block;animation:toastUp 2.5s ease forwards}
.toast.lose{background:linear-gradient(135deg,var(--red),#cc2244);color:#fff;box-shadow:0 4px 20px rgba(255,51,85,.3)}
@keyframes toastUp{0%{opacity:0;bottom:6px}15%{opacity:1;bottom:20px}75%{opacity:1;bottom:20px}100%{opacity:0;bottom:28px}}

::-webkit-scrollbar{width:4px;height:4px}
::-webkit-scrollbar-track{background:var(--bg2)}
::-webkit-scrollbar-thumb{background:var(--border2);border-radius:2px}

/* ===== SVG ICONS ===== */
.icon-home{display:inline-flex}

/* ===== SETTINGS ===== */
.settings-row{display:flex;align-items:center;justify-content:space-between;padding:10px 0;border-bottom:1px solid var(--border);gap:14px;flex-wrap:wrap}
.settings-row:last-child{border-bottom:none}
.settings-lbl{font-size:13px;color:var(--txt);font-family:var(--fu);font-weight:600;min-width:160px}
.settings-toggle{position:relative;display:inline-flex;cursor:pointer}
.settings-toggle input{opacity:0;width:0;height:0;position:absolute}
.tog-track{width:42px;height:22px;background:var(--bg4);border-radius:11px;border:1px solid var(--border);transition:all .2s;display:flex;align-items:center;padding:2px}
.tog-thumb{width:16px;height:16px;background:var(--txt2);border-radius:50%;transition:all .2s}
.settings-toggle input:checked + .tog-track{background:var(--g);border-color:var(--g)}
.settings-toggle input:checked + .tog-track .tog-thumb{transform:translateX(20px);background:#06080b}
.settings-theme-btn{background:var(--bg4);border:1px solid var(--border);border-radius:6px;padding:6px 12px;font-size:11px;font-weight:700;cursor:pointer;color:var(--txt2);font-family:var(--fu);transition:all .15s}
.settings-theme-btn:hover{color:var(--txt)}
.settings-theme-btn.active{border-color:var(--g);color:var(--g);background:#00ff8812}

</style>
</head>
