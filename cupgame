let balance=1000,totalWagered=0,totalWon=0,totalBets=0,winCount=0,biggestWin=0;
let currentUser=null,accounts={},betHistory=[];
let currentStake='poor';
const stakeDefaults={poor:1000,middle:10000,whale:100000,millionaire:1000000,billionaire:1000000000};
