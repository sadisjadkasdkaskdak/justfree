function tctx(c){return c?c.getContext('2d'):null;}
function drawCrashThumb(c){const ctx=tctx(c);if(!ctx)return;ctx.fillStyle='#0a1810';ctx.fillRect(0,0,c.width,c.height);const pts=[];for(let i=0;i<=55;i++){const x=c.width*i/55,y=c.height-10-(i*i*.045);if(y<10)break;pts.push([x,y]);}if(pts.length>1){ctx.beginPath();ctx.moveTo(0,c.height-10);pts.forEach(p=>ctx.lineTo(p[0],p[1]));ctx.strokeStyle='#00ff88';ctx.lineWidth=2;ctx.stroke();}ctx.fillStyle='#00ff88';ctx.font='bold 11px Orbitron,monospace';ctx.textAlign='left';ctx.fillText('CRASH',7,16);}
function drawMinesThumb(c){const ctx=tctx(c);if(!ctx)return;ctx.fillStyle='#1a0a0a';ctx.fillRect(0,0,c.width,c.height);const g=4,cw=c.width/g,ch=c.height/g;for(let r=0;r<g;r++)for(let col=0;col<g;col++){const x=col*cw+2,y=r*ch+2,w=cw-4,h=ch-4;ctx.fillStyle=(r+col)%3===0?'#3a0d0d':'#1c2d1c';ctx.beginPath();ctx.roundRect(x,y,w,h,4);ctx.fill();ctx.font=Math.min(cw,ch)*.45+'px serif';ctx.textAlign='center';ctx.textBaseline='middle';ctx.fillText((r+col)%3===0?'💣':'💎',x+w/2,y+h/2);}}
function drawPlinkoThumb(c){const ctx=tctx(c);if(!ctx)return;ctx.fillStyle='#0a0a1a';ctx.fillRect(0,0,c.width,c.height);for(let r=0;r<5;r++){const n=r+3;for(let col=0;col<n;col++){ctx.beginPath();ctx.arc(c.width/2-(n-1)*12+col*24,14+r*(c.height-38)/5,4,0,Math.PI*2);ctx.fillStyle='#2a4080';ctx.fill();}}}
function drawDiceThumb(c){const ctx=tctx(c);if(!ctx)return;ctx.fillStyle='#0f1a10';ctx.fillRect(0,0,c.width,c.height);function die(ox,oy,sz,val){ctx.fillStyle='#e8e8e8';ctx.beginPath();ctx.roundRect(ox,oy,sz,sz,sz*.12);ctx.fill();ctx.fillStyle='#111';[[.5,.5],[.25,.25],[.75,.75],[.75,.25],[.25,.75],[.25,.5],[.75,.5]].slice(0,val).forEach(([dx,dy])=>{ctx.beginPath();ctx.arc(ox+dx*sz,oy+dy*sz,sz*.09,0,Math.PI*2);ctx.fill();});}die(18,18,52,3);die(82,42,52,5);}
function drawSlotsCandy(c){const ctx=tctx(c);if(!ctx)return;ctx.fillStyle='#1a0020';ctx.fillRect(0,0,c.width,c.height);['🍭','🍓','🍇'].forEach((s,i)=>{ctx.font='28px serif';ctx.textAlign='center';ctx.fillText(s,c.width/6+i*c.width/3,c.height/2+10);});ctx.fillStyle='#ff88ff';ctx.font='bold 9px Orbitron,monospace';ctx.textAlign='left';ctx.fillText('SWEET BONANZA',4,14);}
