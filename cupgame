function drawCrashCanvas(running){const c=document.getElementById('crash-canvas');if(!c)return;const ctx=c.getContext('2d');const W=c.width,H=c.height;ctx.clearRect(0,0,W,H);ctx.fillStyle='#0a1810';ctx.fillRect(0,0,W,H);ctx.strokeStyle='#152520';ctx.lineWidth=.5;for(let i=0;i<=6;i++){ctx.beginPath();ctx.moveTo(0,H*i/6);ctx.lineTo(W,H*i/6);ctx.stroke();}for(let i=0;i<=8;i++){ctx.beginPath();ctx.moveTo(W*i/8,0);ctx.lineTo(W*i/8,H);ctx.stroke();}if(crashPoints.length<2)return;const maxX=crashPoints[crashPoints.length-1][0];const maxY=Math.max(...crashPoints.map(p=>p[1]),2);const tCX=t=>t/maxX*(W-20)+10;const tCY=v=>H-10-(v-1)/(maxY-1)*(H-20);ctx.beginPath();ctx.moveTo(tCX(crashPoints[0][0]),H-10);crashPoints.forEach(p=>ctx.lineTo(tCX(p[0]),tCY(p[1])));ctx.lineTo(tCX(crashPoints[crashPoints.length-1][0]),H-10);ctx.closePath();ctx.fillStyle=running?'#00ff8820':'#ff335515';ctx.fill();ctx.beginPath();ctx.moveTo(tCX(crashPoints[0][0]),tCY(crashPoints[0][1]));crashPoints.forEach(p=>ctx.lineTo(tCX(p[0]),tCY(p[1])));ctx.strokeStyle=running?'#00ff88':'#ff3355';ctx.lineWidth=2.5;ctx.shadowColor=ctx.strokeStyle;ctx.shadowBlur=10;ctx.stroke();ctx.shadowBlur=0;const lp=crashPoints[crashPoints.length-1];ctx.font='16px serif';ctx.textAlign='left';ctx.fillText(running?'🚀':'💥',tCX(lp[0])-8,tCY(lp[1])+6);if(adminMode&&crashRound&&running){crashRound.nodes.forEach(node=>{const nx=node.pos/100*(W-20)+10;ctx.fillStyle=node.type==='ROCKET'?'#ff335566':node.type==='MULT'?'#4488ff66':'#00ff8866';ctx.fillRect(nx-1,0,2,H);});if(crashVal<crashRound.crashAt){const ty=tCY(crashRound.crashAt);if(ty>5&&ty<H-5){ctx.setLineDash([4,4]);ctx.beginPath();ctx.moveTo(0,ty);ctx.lineTo(W,ty);ctx.strokeStyle='#ff335588';ctx.lineWidth=1;ctx.stroke();ctx.setLineDash([]);ctx.fillStyle='#ff3355';ctx.font='bold 10px Orbitron,monospace';ctx.textAlign='right';ctx.fillText('CRASH @ '+crashRound.crashAt.toFixed(2)+'x',W-4,ty-3);}}}[1,2,5,10].filter(v=>v<=maxY).forEach(v=>{const y=tCY(v);if(y>5&&y<H-5){ctx.fillStyle='#2a5040';ctx.font='9px monospace';ctx.textAlign='left';ctx.fillText(v+'x',3,y+3);}});}
function startCrash(){const bet=getBet();if(!bet||bet>balance){toast('Invalid bet!');return;}if(crashRunning)return;balance-=bet;crashBetAmt=bet;crashRunning=true;crashVal=1;crashPoints=[[0,1]];crashRound=generateCrashRound();const mEl=document.getElementById('crash-mult');if(mEl){mEl.className='crash-mult';mEl.style.color='var(--g)';}document.getElementById('crash-go').style.display='none';document.getElementById('crash-cashout').style.display='';document.getElementById('res').className='result-box';if(adminMode){const ai=document.getElementById('crash-admin-info');if(ai)ai.textContent='ADMIN: Crashes @ '+crashRound.crashAt.toFixed(2)+'x · '+crashRound.nodes.length+' nodes';}let t=0;crashTimer=setInterval(()=>{t+=.08;crashVal=Math.pow(Math.E,t*.14);crashPoints.push([t,crashVal]);const mE=document.getElementById('crash-mult');if(mE){mE.textContent=crashVal.toFixed(2)+'x';const col=crashVal<2?'var(--g)':crashVal<5?'#ffd700':crashVal<10?'#ff8822':'#ff3355';mE.style.color=col;mE.style.textShadow='0 0 25px '+col;}drawCrashCanvas(true);if(crashVal>=crashRound.crashAt){clearInterval(crashTimer);crashRunning=false;const m2=document.getElementById('crash-mult');if(m2){m2.className='crash-mult crashed';m2.style.color='var(--red)';}document.getElementById('crash-cashout').style.display='none';document.getElementById('crash-go').style.display='';drawCrashCanvas(false);const r=document.getElementById('res');r.className='result-box show lose';r.textContent='Crashed at '+crashVal.toFixed(2)+'x. Lost '+fmt(crashBetAmt)+'.';recordBet('Crash',crashBetAmt,0);updateBal();toast('Crashed! Lost '+fmt(crashBetAmt),true);}},90);}
function cashoutCrash(){if(!crashRunning)return;clearInterval(crashTimer);crashRunning=false;const win=parseFloat((crashBetAmt*crashVal).toFixed(2));balance+=win;const m=document.getElementById('crash-mult');if(m){m.style.color='var(--gold)';}document.getElementById('crash-cashout').style.display='none';document.getElementById('crash-go').style.display='';const r=document.getElementById('res');r.className='result-box show win';r.textContent='Cashed at '+crashVal.toFixed(2)+'x! Won '+fmt(win)+'!';recordBet('Crash',crashBetAmt,win);updateBal();toast('Cashed out: +'+fmt(win)+'!');}

