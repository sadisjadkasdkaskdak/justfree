function pickHC(n){hcPick=n;document.querySelectorAll('#hc-grid .keno-cell').forEach(c=>c.classList.remove('picked'));document.getElementById('hc-'+n)&&document.getElementById('hc-'+n).classList.add('picked');document.getElementById('hc-pick').textContent='Selected: '+n+(n>10?' (HOT)':' (COLD)');}
function doHotCold(){const bet=getBet();if(!bet||bet>balance){toast('Invalid bet!');return;}if(!hcPick){toast('Pick a number!');return;}let f=0;const anim=setInterval(()=>{const rn=Math.floor(Math.random()*20)+1;document.querySelectorAll('#hc-grid .keno-cell').forEach(c=>c.classList.remove('hit','miss'));const hel=document.getElementById('hc-'+rn);if(hel)hel.classList.add('hit');f++;if(f>22)clearInterval(anim);},80);setTimeout(()=>{const result=Math.floor(Math.random()*20)+1;document.querySelectorAll('#hc-grid .keno-cell').forEach(c=>{c.classList.remove('hit','miss');});const rel=document.getElementById('hc-'+result);if(rel)rel.classList.add(result===hcPick?'hit':'miss');let win=0,msg='';if(result===hcPick){win=parseFloat((bet*18).toFixed(2));msg='Exact! '+result+'! 18:1 Won '+fmt(win)+'.';}else if(result>10&&hcPick>10){win=parseFloat((bet*3).toFixed(2));msg='Both Hot! '+result+'. 3:1 Won '+fmt(win)+'.';}else if(result<=10&&hcPick<=10){win=parseFloat((bet*1.8).toFixed(2));msg='Both Cold! '+result+'. 1.8:1 Won '+fmt(win)+'.';}else{msg='Result '+result+'. Wrong. Lost '+fmt(bet)+'.';}balance-=bet;if(win>0)balance+=win;recordBet('Hot & Cold',bet,win>bet?win:0);showResultRaw(msg,win>0);updateBal();},1800);}

