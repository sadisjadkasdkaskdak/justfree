let tcPlayerCards=[],tcDealerCards=[],tcBetAmt=0;
function buildThreeCard(){return '<div class="poker-table"><div class="poker-label">DEALER</div><div class="card-row" id="tc-dealer"></div><div style="height:6px"></div><div class="poker-label">YOUR HAND</div><div class="card-row" id="tc-player"></div></div><div class="hand-rank" id="tc-rank" style="margin:8px 0"></div><div class="bet-type-row"><span class="bt" data-t="ante" onclick="setBT(\'ante\')">Ante + Play</span><span class="bt" data-t="pairplus" onclick="setBT(\'pairplus\')">Pair Plus</span></div>'+betRow()+'<div style="display:flex;gap:7px;margin-top:6px"><button class="play-btn" id="tc-deal-btn" onclick="tcDeal()">DEAL</button><button class="play-btn" id="tc-play-btn" onclick="tcPlay()" style="display:none;background:var(--gold);color:#06080b">PLAY</button><button class="play-btn" id="tc-fold-btn" onclick="tcFold()" style="display:none;background:var(--red);color:#fff">FOLD</button></div><div class="result-box" id="res"></div>';}
function tcDeal(){tcBetAmt=getBet();if(!tcBetAmt||tcBetAmt>balance){toast('Invalid bet!');return;}if(!activeBetType){toast('Choose Ante+Play or Pair Plus!');return;}balance-=tcBetAmt;updateBal();tcPlayerCards=[rCard(),rCard(),rCard()];tcDealerCards=[rCard(),rCard(),rCard()];document.getElementById('tc-player').innerHTML=tcPlayerCards.map(mkCard).join('');document.getElementById('tc-dealer').innerHTML=adminMode?tcDealerCards.map(c=>'<div class="pcard" style="background:linear-gradient(135deg,#1a1a40,#0a0a28);color:#8888ff;border:2px solid #4444aa">'+c.r+'<br>'+c.s+'</div>').join(''):tcDealerCards.map(()=>mkCardBack()).join('');document.getElementById('tc-rank').textContent='Your hand: '+evalHand(tcPlayerCards);document.getElementById('tc-deal-btn').style.display='none';if(activeBetType==='ante'){document.getElementById('tc-play-btn').style.display='';document.getElementById('tc-fold-btn').style.display='';}else tcResolve();}
function tcPlay(){if(balance<tcBetAmt){toast('Not enough to play!');return;}balance-=tcBetAmt;updateBal();tcResolve();}
function tcFold(){showResultRaw('Folded. Lost '+fmt(tcBetAmt)+'.',false);recordBet('3 Card Poker',tcBetAmt,0);resetTC();updateBal();}
function tcResolve(){document.getElementById('tc-dealer').innerHTML=tcDealerCards.map(mkCard).join('');const pr=getHandStrength(tcPlayerCards),dr=getHandStrength(tcDealerCards);let win=0,msg='';if(activeBetType==='pairplus'){const rk=evalHand(tcPlayerCards);let ppMult=0;if(pr>=2)ppMult=1;if(rk==='Flush')ppMult=4;if(rk==='Straight')ppMult=6;if(rk==='Three of a Kind')ppMult=30;if(ppMult>0){win=parseFloat((tcBetAmt*(ppMult+1)).toFixed(2));balance+=win;msg=rk+'! '+ppMult+':1 Won '+fmt(win);}else{msg='High card. Lost '+fmt(tcBetAmt)+'.';}}else{const dealerQ=tcDealerCards.some(c=>cVal(c.r)>=12)||dr>=2;if(!dealerQ){win=tcBetAmt*2;balance+=win;msg="Dealer doesn't qualify. Won "+fmt(win)+'.';}else if(pr>dr){win=tcBetAmt*4;balance+=win;msg='You win! Won '+fmt(win)+'.';}else if(pr===dr){win=tcBetAmt*2;balance+=win;msg='Push. Returned '+fmt(win)+'.';}else{msg='Dealer wins. Lost '+fmt(tcBetAmt*2)+'.';}}recordBet('3 Card Poker',tcBetAmt,win>tcBetAmt?win:0);showResultRaw(msg,win>0);resetTC();updateBal();}
