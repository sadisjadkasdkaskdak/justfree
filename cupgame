function buildLimbo(){return '<div style="text-align:center;margin:14px 0"><div id="limbo-display" style="font-family:var(--fh);font-size:64px;color:var(--g);letter-spacing:3px;text-shadow:0 0 40px var(--g);min-height:80px;transition:color .1s">1.00x</div><div style="font-size:11px;color:var(--txt2);font-family:var(--fu);margin-top:4px">Win if result exceeds your target</div></div><div class="field-row"><span class="field-label">Target</span><input class="field-input" id="limbo-target" type="number" value="2.00" min="1.01" step="0.01"/></div><div style="display:flex;gap:5px;margin-bottom:10px;flex-wrap:wrap">'+[1.5,2,3,5,10,25,100].map(v=>'<span class="qb" onclick="document.getElementById(\'limbo-target\').value='+v+'">'+v+'x</span>').join('')+'</div>'+betRow()+'<button class="play-btn" id="limbo-btn" onclick="doLimbo()">LAUNCH</button><div class="result-box" id="res"></div>';}
function doLimbo(){const bet=getBet();if(!bet||bet>balance){toast('Invalid bet!');return;}const target=parseFloat(document.getElementById('limbo-target')?.value||2);if(target<=1){toast('Target > 1x required');return;}const btn=document.getElementById('limbo-btn');btn.disabled=true;const result=parseFloat(((1/Math.random())*.97).toFixed(2));if(adminMode)toast('ADMIN: Result = '+result+'x');let shown=1.0;const disp=document.getElementById('limbo-display');const anim=setInterval(()=>{shown=parseFloat((shown*1.18+Math.random()*.1).toFixed(2));if(disp){const col=shown<2?'var(--g)':shown<10?'#ffd700':'#ff8822';disp.style.color=col;disp.style.textShadow='0 0 40px '+col;disp.textContent=shown.toFixed(2)+'x';}if(shown>=result){clearInterval(anim);if(disp)disp.textContent=result.toFixed(2)+'x';const won=result>=target;if(disp)disp.style.color=won?'var(--g)':'var(--red)';const win=won?parseFloat((bet*target).toFixed(2)):0;balance-=bet;if(win>0)balance+=win;recordBet('Limbo',bet,win>bet?win:0);showResultRaw(won?result.toFixed(2)+'x hit '+target+'x target! Won '+fmt(win)+'!':result.toFixed(2)+'x missed '+target+'x. Lost '+fmt(bet)+'.',won);btn.disabled=false;updateBal();}},80);}

