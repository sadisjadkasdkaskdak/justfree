function makeGrid(items,gridId){const g=document.getElementById(gridId);if(!g)return;items.forEach((item,idx)=>{const d=document.createElement('div');d.className='game-card';const badgeHtml=item.badge?'<span class="game-badge badge-'+(item.badge==='LIVE'?'live':item.badge==='NEW'?'new':'hot')+'">'+item.badge+'</span>':'';d.innerHTML='<div class="game-thumb" style="position:relative;overflow:hidden"><canvas class="thumb-canvas" width="160" height="120" id="thumb-'+item.id+'"></canvas>'+badgeHtml+'</div><div class="game-info"><div class="game-name">'+item.name+'</div><div class="game-sub">'+item.sub+'</div></div>';d.onclick=()=>openGame(item);g.appendChild(d);setTimeout(()=>window[item.drawFn]&&window[item.drawFn](document.getElementById('thumb-'+item.id)),50+idx*30);});}
