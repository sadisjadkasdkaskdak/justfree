function doSicBo(){const bet=getBet();if(!bet||bet>balance){toast('Invalid bet!');return;}if(!activeBetType){toast('Choose a bet!');return;}const d1f=Math.floor(Math.random()*6)+1,d2f=Math.floor(Math.random()*6)+1,d3f=Math.floor(Math.random()*6)+1;let f=0;const r=setInterval(()=>{['sb-d1','sb-d2','sb-d3'].forEach(id=>drawDie(id,Math.floor(Math.random()*6)+1));f++;if(f>16)clearInterval(r);},55);setTimeout(()=>{drawDie('sb-d1',d1f);drawDie('sb-d2',d2f);drawDie('sb-d3',d3f);const total=d1f+d2f+d3f;document.getElementById('sb-total').textContent=total;let win=0,msg='';const isTriple=d1f===d2f&&d2f===d3f;if(activeBetType==='big'&&total>=11&&!isTriple){win=bet*2;msg='Big '+total+'! Won '+fmt(win);}else if(activeBetType==='small'&&total<=10&&!isTriple){win=bet*2;msg='Small '+total+'! Won '+fmt(win);}else if(activeBetType==='triple'&&isTriple){win=bet*30;msg='Triple '+d1f+'s! Won '+fmt(win);}else if(activeBetType==='sb-even'&&total%2===0){win=bet*2;msg='Even '+total+'! Won '+fmt(win);}else if(activeBetType==='sb-odd'&&total%2===1){win=bet*2;msg='Odd '+total+'! Won '+fmt(win);}else{msg='Total '+total+'. Lost '+fmt(bet)+'.';}balance-=bet;if(win>0)balance+=win;recordBet('Sic Bo',bet,win>bet?win:0);showResultRaw(msg,win>0);updateBal();},900);}

