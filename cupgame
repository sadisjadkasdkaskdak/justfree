const originals=[{id:'crash',name:'Crash',sub:'Cup Original',badge:'HOT',drawFn:'drawCrashThumb'},{id:'mines',name:'Mines',sub:'Cup Original',badge:'HOT',drawFn:'drawMinesThumb'},{id:'plinko',name:'Plinko',sub:'Cup Original',badge:'NEW',drawFn:'drawPlinkoThumb'},{id:'dice',name:'Dice Roll',sub:'Cup Original',drawFn:'drawDiceThumb'}];
