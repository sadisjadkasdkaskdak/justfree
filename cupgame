function setTheme(name,el){currentTheme=name;const t=themes[name]||themes.default;document.querySelectorAll('.settings-theme-btn').forEach(b=>b.classList.remove('active'));if(el)el.classList.add('active');const r=document.documentElement.style;r.setProperty('--g',t.g);r.setProperty('--g2',t.g2);r.setProperty('--bg',t.bg);r.setProperty('--bg2',t.bg2);r.setProperty('--bg3',t.bg3);r.setProperty('--border',t.border);r.setProperty('--txt',t.txt);try{localStorage.setItem('cup_theme',name);}catch(e){}}
