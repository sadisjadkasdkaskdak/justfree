function showPage(name,el){document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));const pg=document.getElementById('page-'+name);if(pg)pg.classList.add('active');document.querySelectorAll('.sb-item').forEach(i=>i.classList.remove('active'));if(el&&el.classList)el.classList.add('active');if(name==='profile')updateProfileStats();if(name==='sports')renderSports(activeSport);}
