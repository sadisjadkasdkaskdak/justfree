  'fuck','gore','drug','weed','cannabis','cocaine','casino',
  'gambling','poker','slots','torrent','pirate','crack','warez'
];

function isClean(url) {
  const lower = url.toLowerCase();
  return !BLACKLIST.some(w => lower.includes(w));
}

const messages = [
  "Buckle up.", "There's no turning back.", "Your productivity is not my concern.",
  "This is exactly what you needed.", "Science cannot explain this.", "You asked for it.",
  "Completely essential content.", "10/10 waste of time.", "Opening a portal to weirdness...",
