function betMap(root, onChange) {
  const B = { m: {}, h: [], last: null };
  B.add = (k, a) => { B.m[k] = rd((B.m[k] || 0) + a); B.h.push([k, a]); B.paint(); };
  B.undo = () => { const x = B.h.pop(); if (!x) return; B.m[x[0]] = rd(B.m[x[0]] - x[1]); if (B.m[x[0]] <= 0) delete B.m[x[0]]; B.paint(); };
  B.clear = () => { B.m = {}; B.h = []; B.paint(); };
  B.total = () => rd(Object.values(B.m).reduce((a, b) => a + b, 0));
  B.restore = () => { if (!B.last) return; B.m = Object.assign({}, B.last); B.h = Object.entries(B.last); B.paint(); };
  B.paint = () => { $$('[data-bet]', root).forEach(e => { const v = B.m[e.dataset.bet]; let c = e.querySelector('.chipbadge'); if (v) { if (!c) { c = document.createElement('span'); c.className = 'chipbadge'; e.appendChild(c); } c.textContent = fs(v); } else if (c) c.remove(); }); if (onChange) onChange(); };
  return B;
}
