<script>
/* =====================================================================
   CUP CASINO — math engine (pure, no DOM).  Runs in browser and Node.
   Everything that decides an outcome or a payout lives here so it can be
   simulated.  UI code only calls these functions.
   ===================================================================== */
var CM = (function () {
  const CM = {};

  /* ---------- RNG ---------- */
  let nodeCrypto = null;
  if (typeof require !== 'undefined') { try { nodeCrypto = require('crypto'); } catch (e) {} }
  CM.rnd = function () {
    const a = new Uint32Array(2);
    if (typeof crypto !== 'undefined' && crypto.getRandomValues) crypto.getRandomValues(a);
    else if (nodeCrypto) nodeCrypto.randomFillSync(a);
    else { a[0] = Math.random() * 4294967296; a[1] = Math.random() * 4294967296; }
    return (a[0] * 2097152 + (a[1] >>> 11)) / 9007199254740992;
  };
  // fast PRNG for simulations (xorshift128+) — only used by Node tests
  CM.useFastRng = function (seed) {
    let s0 = (seed || 123456789) >>> 0, s1 = 362436069, s2 = 521288629, s3 = 88675123;
    CM.rnd = function () {
      let t = s0 ^ (s0 << 11); s0 = s1; s1 = s2; s2 = s3;
      s3 = (s3 ^ (s3 >>> 19)) ^ (t ^ (t >>> 8));
      const hi = (s3 >>> 0), lo = ((s2 ^ (s1 << 7)) >>> 0);
      return (hi * 2097152 + (lo >>> 11)) / 9007199254740992;
    };
  };
  CM.rint = n => Math.floor(CM.rnd() * n);
  CM.pick = a => a[CM.rint(a.length)];
  CM.shuffle = function (a) { a = a.slice(); for (let i = a.length - 1; i > 0; i--) { const j = CM.rint(i + 1); [a[i], a[j]] = [a[j], a[i]]; } return a; };
  CM.weighted = function (items, weights) {
    let tot = 0; for (const w of weights) tot += w;
    let r = CM.rnd() * tot;
    for (let i = 0; i < items.length; i++) { r -= weights[i]; if (r < 0) return items[i]; }
    return items[items.length - 1];
  };
  const _C = {};
  CM.C = function (n, k) {
    if (k < 0 || k > n) return 0; if (k === 0 || k === n) return 1;
    const key = n + ',' + k; if (_C[key] !== undefined) return _C[key];
    let r = 1; k = Math.min(k, n - k);
    for (let i = 1; i <= k; i++) r = r * (n - k + i) / i;
    return (_C[key] = r);
  };
  CM.EDGE = 0.01;                         // house edge on Cup Originals (1%)

  /* ---------- CRASH / LIMBO ---------- */
  // P(point >= m) = 0.99 / m   →  RTP 99% at any cash-out target
