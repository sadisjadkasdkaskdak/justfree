<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>Cup Casino — Play-Money Sandbox</title>
<link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@500;600;700&family=Orbitron:wght@400;700;900&family=Inter:wght@300;400;500;600&family=Bebas+Neue&display=swap" rel="stylesheet"/>
<style>
*{box-sizing:border-box;margin:0;padding:0}
:root{
  --g:#22d37a;--g2:#17a85f;--red:#ff4466;--gold:#ffd24a;--blue:#3b9bff;--purple:#a65cff;--orange:#ff8a2a;
  --acc:#ffb400;--acc2:#ff8a00;
  --bg:#0b1220;--bg2:#101a2e;--bg3:#15213a;--bg4:#1b2a48;--bg5:#22345a;
  --txt:#d5deef;--txt2:#7587a8;--txt3:#9aaccb;--border:#223356;--border2:#2d4373;
  --fd:'Orbitron',sans-serif;--fb:'Inter',system-ui,sans-serif;--fu:'Rajdhani',sans-serif;--fh:'Bebas Neue',sans-serif;
}
html,body{height:100%}
body{background:var(--bg);color:var(--txt);font-family:var(--fb);font-size:13px;overflow:hidden}
body.no-anim *{animation:none!important;transition:none!important}
button{font-family:inherit}
input,select{font-family:inherit}
.app{display:flex;flex-direction:column;height:100vh;overflow:hidden}
.app-body{display:flex;flex:1;min-height:0;overflow:hidden}

/* ---------- HEADER ---------- */
.hdr{display:flex;align-items:center;gap:18px;height:56px;padding:0 16px;background:linear-gradient(180deg,#132040,#0f1a31);border-bottom:1px solid var(--border);flex-shrink:0;z-index:20}
.hdr-logo{display:flex;align-items:center;gap:9px;cursor:pointer;flex-shrink:0}
.logo-icon{width:34px;height:34px;border-radius:9px;background:linear-gradient(135deg,var(--acc),var(--acc2));display:flex;align-items:center;justify-content:center}
.logo-text{font-family:var(--fh);font-size:24px;letter-spacing:2px;color:#fff;line-height:1}
.logo-text b{color:var(--acc);font-weight:400}
.logo-sub{font-size:9px;color:var(--txt2);letter-spacing:3px;font-family:var(--fu)}
.hdr-nav{display:flex;align-items:stretch;gap:2px;height:100%;overflow-x:auto;scrollbar-width:none}
.hn{display:flex;align-items:center;gap:6px;padding:0 15px;font-family:var(--fu);font-weight:700;font-size:14px;letter-spacing:.6px;text-transform:uppercase;color:var(--txt3);cursor:pointer;border-bottom:3px solid transparent;white-space:nowrap;transition:all .15s}
.hn:hover{color:#fff;background:#ffffff08}
.hn.active{color:#fff;border-bottom-color:var(--acc);background:linear-gradient(180deg,transparent,#ffb40014)}
.hn .dot{width:6px;height:6px;border-radius:50%;background:var(--red);animation:ldot 1s infinite}
.search-wrap{position:relative}
.search-wrap svg{position:absolute;left:10px;top:50%;transform:translateY(-50%);width:13px;height:13px;fill:none;stroke:var(--txt2);stroke-width:2;pointer-events:none}
.search-bar{background:var(--bg);border:1px solid var(--border);border-radius:18px;padding:7px 14px 7px 32px;color:var(--txt);font-size:12px;outline:none;width:190px}
.search-bar:focus{border-color:var(--acc)}
.topbar-right{display:flex;align-items:center;gap:8px;margin-left:auto}
.bal-pill{background:var(--bg);border:1px solid var(--border2);border-radius:18px;padding:5px 6px 5px 12px;display:flex;align-items:center;gap:8px;font-size:12px;cursor:pointer}
.bal-pill:hover{border-color:var(--acc)}
.bal-amt{color:var(--acc);font-weight:700;font-size:13px;font-family:var(--fd)}
.bal-plus{background:var(--acc);color:#1a1100;border-radius:50%;width:20px;height:20px;display:flex;align-items:center;justify-content:center;font-weight:900;font-size:14px;line-height:1}
.btn{border:none;border-radius:7px;padding:7px 14px;font-size:12px;font-weight:700;cursor:pointer;font-family:var(--fu);transition:all .15s;letter-spacing:.5px;text-transform:uppercase}
.btn-outline{background:transparent;border:1px solid var(--border2);color:var(--txt)}
.btn-outline:hover{border-color:var(--acc);color:var(--acc)}
.btn-primary{background:linear-gradient(135deg,var(--acc),var(--acc2));color:#1a1100}
.btn-primary:hover{filter:brightness(1.1)}
.btn-danger{background:#ff446620;border:1px solid var(--red);color:var(--red)}

/* ---------- SIDEBAR ---------- */
.sidebar{width:196px;flex-shrink:0;background:var(--bg2);border-right:1px solid var(--border);display:flex;flex-direction:column;overflow-y:auto;padding-bottom:8px}
.sb-sec{padding:16px 14px 4px;font-size:9px;font-weight:700;color:var(--txt2);letter-spacing:2px;text-transform:uppercase;font-family:var(--fu)}
.sb-item{display:flex;align-items:center;gap:9px;padding:9px 10px;margin:1px 6px;border-radius:8px;color:var(--txt2);cursor:pointer;font-size:13px;font-family:var(--fu);font-weight:600;transition:all .15s}
.sb-item:hover{background:var(--bg4);color:var(--txt)}
.sb-item.active{background:var(--bg4);color:var(--acc);box-shadow:inset 3px 0 0 var(--acc)}
.sb-ico{width:20px;text-align:center;font-size:15px;flex-shrink:0}
.sb-badge{margin-left:auto;font-size:8px;padding:2px 5px;border-radius:6px;font-weight:700;font-family:var(--fu)}
.sb-badge.hot{background:#ff446622;color:var(--red)}.sb-badge.new{background:#ffb40022;color:var(--acc)}.sb-badge.live{background:#3b9bff22;color:var(--blue)}
.user-panel{padding:8px;margin-top:auto}
.user-info{display:flex;align-items:center;gap:8px;background:var(--bg3);border-radius:10px;padding:8px;cursor:pointer;border:1px solid var(--border)}
.user-info:hover{border-color:var(--acc)}
.user-avatar{width:30px;height:30px;border-radius:50%;background:linear-gradient(135deg,var(--acc),var(--acc2));display:flex;align-items:center;justify-content:center;color:#1a1100;font-weight:700;font-family:var(--fh);font-size:14px;flex-shrink:0}
.user-name{font-weight:600;font-family:var(--fu);font-size:13px;color:#fff}
.user-bal{font-size:11px;color:var(--acc);font-weight:700}

/* ---------- PAGES ---------- */
.main{flex:1;display:flex;flex-direction:column;overflow:hidden;min-width:0}
.page{display:none;flex:1;overflow-y:auto;flex-direction:column;min-height:0}
.page.active{display:flex}
.pad{padding:20px}
.h-page{font-family:var(--fh);font-size:26px;color:#fff;letter-spacing:2px;margin-bottom:14px}

/* ---------- HOME ---------- */
.hero{padding:14px 16px 12px;flex-shrink:0}
.hero-grid{display:grid;grid-template-columns:minmax(0,2.2fr) minmax(0,1fr);gap:12px}
.banner{position:relative;height:196px;border-radius:14px;overflow:hidden;border:1px solid var(--border2)}
.slide{position:absolute;inset:0;padding:24px 28px;display:flex;flex-direction:column;justify-content:center;opacity:0;transition:opacity .6s;pointer-events:none}
.slide.on{opacity:1;pointer-events:auto}
.slide .tag{font-family:var(--fu);font-weight:700;font-size:11px;letter-spacing:3px;color:var(--acc);margin-bottom:6px}
.slide h2{font-family:var(--fh);font-size:42px;letter-spacing:2px;color:#fff;line-height:1;margin:0 0 6px;font-weight:400}
.slide p{max-width:360px;font-size:12px;color:#c5d3ee;margin-bottom:14px;line-height:1.5}
.slide .btn{align-self:flex-start;padding:9px 20px;font-size:13px}
.slide .art{position:absolute;right:26px;top:50%;transform:translateY(-50%);font-size:110px;filter:drop-shadow(0 10px 30px rgba(0,0,0,.5))}
.s1{background:radial-gradient(circle at 85% 40%,#ffb40033,transparent 45%),linear-gradient(120deg,#1a2f66,#0d1a3a)}
.s2{background:radial-gradient(circle at 85% 40%,#ff446633,transparent 45%),linear-gradient(120deg,#3a1030,#14101f)}
.s3{background:radial-gradient(circle at 85% 40%,#22d37a33,transparent 45%),linear-gradient(120deg,#0b3a35,#0b1a24)}
.s4{background:radial-gradient(circle at 85% 40%,#a65cff33,transparent 45%),linear-gradient(120deg,#2a1a5e,#10122a)}
.dots{position:absolute;bottom:10px;left:28px;display:flex;gap:6px;z-index:3}
.dots i{width:18px;height:4px;border-radius:2px;background:#ffffff33;cursor:pointer;transition:all .2s}
.dots i.on{background:var(--acc);width:30px}
.hero-side{display:flex;flex-direction:column;gap:8px}
.hstat{display:flex;align-items:center;justify-content:space-between;background:var(--bg3);border:1px solid var(--border);border-radius:10px;padding:6px 14px;flex:1}
.hstat-lbl{font-size:11px;color:var(--txt3);text-transform:uppercase;letter-spacing:1px;font-family:var(--fu);font-weight:700}
.hstat-val{font-family:var(--fd);font-size:15px;font-weight:700;color:var(--g)}
.hstat-val.red{color:var(--red)}
.jackpot{display:flex;align-items:center;justify-content:space-between;background:linear-gradient(120deg,#3a2a00,#1d1500);border:1px solid #ffb40055;border-radius:10px;padding:8px 14px}
.jl{font-family:var(--fu);font-size:11px;letter-spacing:2px;color:var(--acc);font-weight:700}
.jv{font-family:var(--fd);font-weight:900;color:#ffd24a;font-size:17px}
.stakes-bar{display:flex;align-items:center;gap:7px;padding:2px 16px 10px;overflow-x:auto;flex-shrink:0}
.stakes-lbl{font-size:10px;color:var(--txt2);font-family:var(--fu);font-weight:700;white-space:nowrap;letter-spacing:1px}
.stake-btn{padding:5px 13px;border-radius:8px;font-size:11px;font-weight:700;cursor:pointer;border:1px solid var(--border);color:var(--txt2);font-family:var(--fu);transition:all .15s;white-space:nowrap;background:var(--bg3)}
.stake-btn:hover{color:var(--txt)}
.stake-btn.active{border-color:var(--acc);color:var(--acc);background:#ffb40014}
.cat-tabs{display:flex;gap:6px;padding:0 16px;border-bottom:1px solid var(--border);overflow-x:auto;flex-shrink:0}
.cat-tab{padding:10px 16px;font-size:13px;font-weight:700;color:var(--txt2);cursor:pointer;white-space:nowrap;border-bottom:2px solid transparent;font-family:var(--fu);text-transform:uppercase;letter-spacing:.6px}
.cat-tab:hover{color:var(--txt)}
.cat-tab.active{color:var(--acc);border-bottom-color:var(--acc)}
.content-area{display:flex;flex:1;min-height:0}
.feed-panel{flex:1;padding:16px;overflow-y:auto;min-width:0}
.live-panel{width:210px;background:var(--bg2);border-left:1px solid var(--border);padding:10px;flex-shrink:0;overflow-y:auto}
.sec-hdr{display:flex;align-items:center;justify-content:space-between;margin-bottom:10px}
.sec-hdr h3{font-family:var(--fh);font-size:20px;letter-spacing:2px;font-weight:400;color:#fff;padding-left:10px;border-left:4px solid var(--acc)}
.see-all{font-size:11px;color:var(--blue);cursor:pointer;font-family:var(--fu);font-weight:700}
.games-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:12px;margin-bottom:26px}
.game-card{background:var(--bg3);border-radius:12px;overflow:hidden;cursor:pointer;border:1px solid var(--border);transition:all .2s}
.game-card:hover{border-color:var(--acc);transform:translateY(-3px);box-shadow:0 10px 28px rgba(255,180,0,.12)}
.game-thumb{width:100%;aspect-ratio:4/3;display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden}
.game-thumb .ic{font-size:54px;filter:drop-shadow(0 6px 14px rgba(0,0,0,.5));transition:transform .25s}
.game-card:hover .ic{transform:scale(1.12) rotate(-4deg)}
.game-thumb .rtp{position:absolute;bottom:5px;right:6px;font-size:9px;font-family:var(--fu);font-weight:700;color:#fff;background:#0008;border-radius:4px;padding:1px 5px}
.game-thumb::after{content:'\25B6  PLAY';position:absolute;inset:0;display:flex;align-items:center;justify-content:center;background:rgba(6,10,20,.62);color:var(--acc);font-family:var(--fh);font-size:20px;letter-spacing:3px;opacity:0;transition:opacity .18s}
.game-card:hover .game-thumb::after{opacity:1}
.game-badge{position:absolute;top:6px;left:6px;font-size:8px;font-weight:700;padding:2px 6px;border-radius:4px;font-family:var(--fu);z-index:2;letter-spacing:.5px}
.badge-hot{background:var(--red);color:#fff}.badge-new{background:var(--acc);color:#1a1100}.badge-live{background:var(--blue);color:#fff}
.game-info{padding:7px 9px 9px}
.game-name{font-size:13px;font-weight:600;color:#fff;font-family:var(--fu)}
.game-sub{font-size:10px;color:var(--txt2);margin-top:1px}
.live-hdr{font-size:12px;font-weight:700;color:#fff;margin-bottom:8px;display:flex;align-items:center;gap:5px;font-family:var(--fd)}
.live-dot{width:6px;height:6px;border-radius:50%;background:var(--red);animation:ldot 1s infinite}
@keyframes ldot{0%,100%{opacity:1}50%{opacity:.3}}
.bet-row{display:flex;align-items:center;gap:6px;padding:5px 0;border-bottom:1px solid var(--border);animation:fadeIn .3s ease}
@keyframes fadeIn{from{opacity:0;transform:translateY(-3px)}to{opacity:1;transform:none}}
.bet-av{width:22px;height:22px;border-radius:50%;background:var(--bg4);display:flex;align-items:center;justify-content:center;font-size:9px;color:var(--acc);font-weight:700;font-family:var(--fh);flex-shrink:0}
.bet-info{flex:1;min-width:0}
.bet-user{font-size:10px;color:var(--txt);font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-family:var(--fu)}
.bet-game{font-size:9px;color:var(--txt2);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.bet-amt{font-size:10px;font-weight:700;white-space:nowrap;font-family:var(--fd)}
.bet-amt.g{color:var(--g)}.bet-amt.r{color:var(--red)}
.site-foot{margin-top:auto;border-top:1px solid var(--border);padding:16px;font-size:11px;color:var(--txt2);text-align:center;line-height:1.7;background:var(--bg2)}
.site-foot b{color:var(--acc)}

/* ---------- MODAL ---------- */
.modal-wrap{display:none;background:rgba(3,6,14,.86);position:fixed;inset:0;z-index:300;align-items:center;justify-content:center;backdrop-filter:blur(6px)}
.modal-wrap.open{display:flex}
.modal{background:var(--bg2);border:1px solid var(--border2);border-radius:16px;width:min(97vw,1040px);max-height:94vh;overflow:hidden;position:relative;box-shadow:0 24px 80px rgba(0,0,0,.8);display:flex;flex-direction:column}
.modal.sm{width:min(95vw,440px)}
.modal-header{padding:12px 18px;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:12px;flex-shrink:0;background:linear-gradient(180deg,#16244a,var(--bg2))}
.modal-header h3{font-family:var(--fh);color:#fff;font-size:22px;font-weight:400;letter-spacing:2px;flex:1}
.m-info{font-family:var(--fu);font-size:12px;color:var(--txt2)}
.m-balance{font-family:var(--fd);font-size:12px;color:var(--acc);background:var(--bg);border:1px solid var(--border);border-radius:14px;padding:4px 12px}
.modal-close{background:none;border:none;color:var(--txt2);font-size:18px;cursor:pointer;padding:4px 8px;border-radius:6px}
.modal-close:hover{color:#fff;background:var(--bg4)}
.modal-body{overflow-y:auto;flex:1;min-height:0}
.modal-foot{padding:6px 16px;border-top:1px solid var(--border);font-size:10px;color:var(--txt2);display:flex;gap:16px;font-family:var(--fu);flex-wrap:wrap}
.modal-foot b{color:var(--txt3)}
.pad-m{padding:18px 20px}

/* ---------- GAME LAYOUT ---------- */
.gm{display:grid;grid-template-columns:300px minmax(0,1fr);min-height:480px}
.gm-ctrl{background:var(--bg3);padding:16px;display:flex;flex-direction:column;gap:11px;border-right:1px solid var(--border)}
.gm-stage{background:radial-gradient(ellipse at 50% 0%,#14224a,var(--bg) 70%);padding:18px;position:relative;display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:420px;min-width:0}
.gm-stage.top{justify-content:flex-start}
.lbl{font-size:10px;font-weight:700;letter-spacing:1px;color:var(--txt3);text-transform:uppercase;font-family:var(--fu);display:flex;justify-content:space-between;align-items:center}
.lbl b{color:var(--txt);font-family:var(--fd);font-weight:700;letter-spacing:0;font-size:11px}
.inp-wrap{display:flex;align-items:stretch;background:var(--bg);border:1px solid var(--border2);border-radius:8px;overflow:hidden}
.inp-wrap:focus-within{border-color:var(--acc)}
.inp-wrap input{flex:1;min-width:0;background:transparent;border:none;outline:none;color:#fff;padding:9px 10px;font-size:14px;font-family:var(--fd)}
.inp-wrap .cur{display:flex;align-items:center;padding:0 0 0 10px;color:var(--acc);font-weight:700}
.inp-wrap button{background:var(--bg4);border:none;border-left:1px solid var(--border2);color:var(--txt3);padding:0 11px;font-size:12px;font-weight:700;cursor:pointer;font-family:var(--fu)}
.inp-wrap button:hover{background:var(--bg5);color:#fff}
.seg{display:flex;background:var(--bg);border:1px solid var(--border2);border-radius:8px;padding:3px;gap:3px;flex-wrap:wrap}
.seg>button{flex:1;background:transparent;border:none;color:var(--txt3);padding:7px 6px;border-radius:6px;font-size:12px;font-weight:700;cursor:pointer;font-family:var(--fu);letter-spacing:.4px;text-transform:uppercase;min-width:0;white-space:nowrap}
.seg>button:hover{color:#fff}
.seg>button.on{background:var(--bg5);color:var(--acc)}
.seg>button:disabled{opacity:.4;cursor:not-allowed}
.act{width:100%;border:none;border-radius:9px;padding:13px;font-size:16px;font-weight:400;cursor:pointer;font-family:var(--fh);letter-spacing:2px;transition:all .15s;background:linear-gradient(135deg,var(--g),var(--g2));color:#04140b}
.act:hover:not(:disabled){filter:brightness(1.1);transform:translateY(-1px)}
.act:disabled{background:var(--bg5);color:var(--txt2);cursor:not-allowed;transform:none;filter:none}
.act.gold{background:linear-gradient(135deg,var(--acc),var(--acc2));color:#1a1100}
.act.red{background:linear-gradient(135deg,#ff5577,#d02a4a);color:#fff}
.act.ghost{background:var(--bg4);color:var(--txt);border:1px solid var(--border2)}
.row2{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.hint{font-size:11px;color:var(--txt2);line-height:1.5}
.stat-box{background:var(--bg);border:1px solid var(--border);border-radius:8px;padding:8px 10px}
.stat-box .k{font-size:9px;color:var(--txt2);text-transform:uppercase;letter-spacing:1px;font-family:var(--fu);font-weight:700}
.stat-box .v{font-family:var(--fd);font-size:14px;color:#fff;margin-top:2px}
.stat-box .v.g{color:var(--g)}.stat-box .v.r{color:var(--red)}
.res{margin-top:12px;min-height:40px;padding:10px 14px;border-radius:10px;font-size:13px;font-weight:700;text-align:center;font-family:var(--fd);width:100%;max-width:560px;display:none}
.res.show{display:block;animation:pop .3s ease}
@keyframes pop{from{transform:scale(.93);opacity:0}to{transform:none;opacity:1}}
.res.win{background:#22d37a1a;border:1px solid #22d37a55;color:var(--g)}
.res.lose{background:#ff44661a;border:1px solid #ff446655;color:var(--red)}
.res.push{background:#ffd24a18;border:1px solid #ffd24a55;color:var(--gold)}
.chips{display:flex;gap:5px;flex-wrap:wrap}
.chip{background:var(--bg);border:1px solid var(--border2);border-radius:14px;padding:3px 10px;font-size:11px;color:var(--txt3);cursor:pointer;font-family:var(--fu);font-weight:700}
.chip:hover,.chip.on{border-color:var(--acc);color:var(--acc)}
.toggle{display:inline-flex;align-items:center;gap:8px;cursor:pointer;font-size:12px;color:var(--txt3);font-family:var(--fu);font-weight:600}
.toggle input{display:none}
.toggle .tk{width:36px;height:20px;border-radius:10px;background:var(--bg5);position:relative;transition:.2s;flex-shrink:0}
.toggle .tk::after{content:'';position:absolute;left:2px;top:2px;width:16px;height:16px;border-radius:50%;background:var(--txt2);transition:.2s}
.toggle input:checked+.tk{background:var(--acc)}
.toggle input:checked+.tk::after{left:18px;background:#1a1100}
input[type=range]{width:100%;accent-color:var(--acc)}
.big-num{font-family:var(--fh);font-size:78px;letter-spacing:3px;line-height:1;text-shadow:0 0 40px currentColor;transition:color .15s}
.hist-pills{display:flex;gap:5px;flex-wrap:wrap;justify-content:center;min-height:24px;margin-bottom:8px}
.pill{font-family:var(--fd);font-size:10px;font-weight:700;padding:3px 9px;border-radius:12px;border:1px solid}
.pill.w{background:#22d37a18;border-color:#22d37a55;color:var(--g)}.pill.l{background:#ff446618;border-color:#ff446655;color:var(--red)}.pill.m{background:#ffd24a15;border-color:#ffd24a55;color:var(--gold)}

/* ---------- CARDS ---------- */
.cards{display:flex;gap:6px;justify-content:center;margin:8px 0;flex-wrap:wrap;min-height:84px}
.pc{width:56px;height:80px;background:#fff;border-radius:7px;display:flex;flex-direction:column;align-items:center;justify-content:center;font-size:19px;font-weight:700;border:1px solid #ccc;box-shadow:0 3px 12px rgba(0,0,0,.45);animation:deal .28s ease;flex-shrink:0;line-height:1.1;position:relative}
.pc small{font-size:18px}
@keyframes deal{from{transform:translateY(-14px) rotateY(80deg);opacity:0}to{transform:none;opacity:1}}
.pc.r{color:#cc1f1f}.pc.b{color:#111}
.pc.back{background:repeating-linear-gradient(45deg,#1a3a8a,#1a3a8a 5px,#0f2766 5px,#0f2766 10px);border:2px solid #fff}
.pc.sm{width:44px;height:62px;font-size:15px}
.pc.sel{outline:3px solid var(--acc);transform:translateY(-8px)}
.pc.win{box-shadow:0 0 0 3px var(--g),0 0 20px #22d37a88}
.felt{background:radial-gradient(ellipse at center,#0f5a2c 0%,#073015 100%);border:3px solid #1c7a3e;border-radius:90px/40px;padding:16px 20px;width:100%;max-width:640px;box-shadow:inset 0 0 40px #0008}
.felt.purple{background:radial-gradient(ellipse at center,#3b1760 0%,#150a28 100%);border-color:#5b2a94}
.felt.blue{background:radial-gradient(ellipse at center,#0f3b66 0%,#071626 100%);border-color:#1f6eaa}
.felt.red{background:radial-gradient(ellipse at center,#6a1521 0%,#2a0810 100%);border-color:#a02a3e}
.felt-lbl{font-size:10px;letter-spacing:2px;color:#ffffff88;text-align:center;font-family:var(--fu);font-weight:700;text-transform:uppercase}
.score-tag{text-align:center;font-family:var(--fd);font-size:13px;color:#fff;background:#0007;border-radius:10px;padding:2px 12px;display:inline-block}

/* ---------- MINES / TOWERS ---------- */
.mines-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:8px;width:100%;max-width:440px}
.mcell{aspect-ratio:1;background:var(--bg4);border:none;border-bottom:4px solid #0c1527;border-radius:10px;cursor:pointer;font-size:30px;display:flex;align-items:center;justify-content:center;transition:all .12s;color:#fff}
.mcell:hover:not(.open):not(:disabled){background:var(--bg5);transform:translateY(-2px)}
.mcell.open{background:#0e1830;border-bottom-color:#0e1830;cursor:default}
.mcell.gem{background:#0d3b2a;animation:pop .25s}
.mcell.bomb{background:#4a1222;animation:shake .35s}
.mcell.dim{opacity:.45}
.mcell:disabled{cursor:default}
@keyframes shake{0%,100%{transform:translateX(0)}25%{transform:translateX(-5px)}75%{transform:translateX(5px)}}
.tower{display:flex;flex-direction:column-reverse;gap:6px;width:100%;max-width:440px}
.trow{display:grid;gap:6px;position:relative}
.trow .lv{position:absolute;left:-52px;top:50%;transform:translateY(-50%);font-family:var(--fd);font-size:10px;color:var(--txt2);width:46px;text-align:right}
.trow.cur .lv{color:var(--acc)}
.tcell{height:38px;border:none;border-radius:8px;background:var(--bg4);color:#fff;font-size:18px;cursor:pointer;border-bottom:3px solid #0c1527}
.trow.cur .tcell{background:var(--bg5);box-shadow:0 0 0 1px var(--acc)}
.tcell:disabled{cursor:default}
.tcell.gem{background:#0d3b2a}.tcell.bomb{background:#4a1222}.tcell.dim{opacity:.4}

/* ---------- KENO ---------- */
.keno-grid{display:grid;grid-template-columns:repeat(8,1fr);gap:6px;width:100%;max-width:560px}
.kcell{aspect-ratio:1.25;background:var(--bg4);border:none;border-bottom:3px solid #0c1527;border-radius:8px;color:#fff;font-family:var(--fd);font-weight:700;font-size:13px;cursor:pointer;transition:.12s;display:flex;align-items:center;justify-content:center}
.kcell:hover:not(:disabled){background:var(--bg5)}
.kcell.pick{background:#4b2d96;box-shadow:0 0 0 2px var(--purple)}
.kcell.hit{background:#0d5a3a;box-shadow:0 0 0 2px var(--g);animation:pop .25s}
.kcell.miss{background:#2a1020;color:#ff9aa8}
.kcell.drawn{background:#2a3a66}
.paytable{display:flex;gap:4px;flex-wrap:wrap;justify-content:center;margin-top:12px;max-width:560px}
.pt{background:var(--bg);border:1px solid var(--border);border-radius:7px;padding:4px 7px;text-align:center;min-width:54px}
.pt .h{font-size:9px;color:var(--txt2);font-family:var(--fu);font-weight:700}
.pt .m{font-family:var(--fd);font-size:11px;color:#fff}
.pt.lit{border-color:var(--g);background:#22d37a18}.pt.lit .m{color:var(--g)}

/* ---------- PLINKO / CANVAS ---------- */
canvas.fit{width:100%;height:auto;max-width:640px;border-radius:12px;display:block}

/* ---------- WHEEL ---------- */
.wheel-box{position:relative;width:min(100%,380px);aspect-ratio:1}
.wheel-box canvas{width:100%;height:100%;border-radius:50%}
.wheel-ptr{position:absolute;top:-8px;left:50%;transform:translateX(-50%);width:0;height:0;border-left:13px solid transparent;border-right:13px solid transparent;border-top:28px solid #fff;filter:drop-shadow(0 3px 6px #0008);z-index:3}

/* ---------- DICE ---------- */
.dice-track{position:relative;width:100%;max-width:620px;height:18px;border-radius:9px;margin:34px 0 22px;background:var(--red)}
.dice-track .win{position:absolute;top:0;bottom:0;background:var(--g);border-radius:9px}
.dice-track .mark{position:absolute;top:-30px;transform:translateX(-50%);background:#fff;color:#000;font-family:var(--fd);font-weight:700;font-size:12px;padding:3px 8px;border-radius:6px;transition:left .5s cubic-bezier(.2,.9,.3,1)}
.dice-track .mark::after{content:'';position:absolute;bottom:-5px;left:50%;margin-left:-5px;border:5px solid transparent;border-top-color:#fff;border-bottom:0}
.dice-slider{width:100%;max-width:620px}
.dice-scale{display:flex;justify-content:space-between;width:100%;max-width:620px;font-size:10px;color:var(--txt2);font-family:var(--fd)}

/* ---------- ROULETTE / TABLE BETTING ---------- */
.rou-wrap{display:flex;flex-direction:column;gap:10px;width:100%;align-items:center}
.rou-board{display:grid;grid-template-columns:44px repeat(12,1fr) 44px;gap:3px;width:100%;max-width:700px}
.rc{position:relative;background:#0f4a28;border:1px solid #1c7a3e;color:#fff;border-radius:5px;height:38px;display:flex;align-items:center;justify-content:center;font-family:var(--fd);font-weight:700;font-size:12px;cursor:pointer;user-select:none}
.rc:hover{filter:brightness(1.35)}
.rc.red{background:#a01824}.rc.black{background:#16191f}.rc.green{background:#0e7a3a}
.rc.out{background:#12365a;border-color:#2a6aa0;font-size:11px}
.chipbadge{position:absolute;right:-4px;top:-6px;min-width:20px;height:20px;border-radius:10px;background:var(--acc);color:#1a1100;font-size:9px;font-weight:900;display:flex;align-items:center;justify-content:center;padding:0 4px;border:2px solid #fff;z-index:2;font-family:var(--fd)}
.rou-out{display:grid;gap:3px;width:100%;max-width:700px}
.rou-out.c3{grid-template-columns:repeat(3,1fr)}.rou-out.c6{grid-template-columns:repeat(6,1fr)}
.rou-ball-res{font-family:var(--fh);font-size:64px;letter-spacing:2px;width:100px;height:100px;border-radius:50%;display:flex;align-items:center;justify-content:center;border:4px solid #fff;color:#fff}

/* ---------- SLOTS ---------- */
.slot-frame{border-radius:16px;padding:12px;width:100%;max-width:720px;border:2px solid}
.slot-title{text-align:center;font-family:var(--fh);font-size:22px;letter-spacing:4px;margin-bottom:6px}
.tgrid{display:grid;gap:4px;border-radius:12px;padding:6px}
.tcell2{aspect-ratio:1;display:flex;align-items:center;justify-content:center;font-size:34px;border-radius:9px;transition:all .25s;position:relative}
.tcell2.win{animation:winpulse .5s ease infinite alternate;z-index:2}
@keyframes winpulse{from{transform:scale(1)}to{transform:scale(1.14)}}
.tcell2.pop{animation:popout .3s forwards}
@keyframes popout{to{transform:scale(0);opacity:0}}
.tcell2.drop{animation:dropin .35s ease}
@keyframes dropin{from{transform:translateY(-90px);opacity:0}to{transform:none;opacity:1}}
.tcell2 .bv{position:absolute;bottom:2px;right:3px;font-size:11px;font-weight:900;font-family:var(--fd);color:#fff;text-shadow:0 0 4px #000}
.lgrid{display:grid;grid-template-columns:repeat(5,1fr);gap:5px;padding:8px;border-radius:12px}
.lreel{display:flex;flex-direction:column;gap:5px;overflow:hidden}
.lcell{aspect-ratio:1;display:flex;align-items:center;justify-content:center;font-size:36px;border-radius:9px;font-family:var(--fu);font-weight:700;position:relative;transition:transform .2s}
.lcell.txt{font-size:26px;color:#fff}
.lcell.spin{filter:blur(2px)}
.lcell.win{animation:winpulse .45s ease infinite alternate;z-index:2}
.lcell .cv{position:absolute;bottom:1px;right:3px;font-size:11px;font-weight:900;font-family:var(--fd);color:#ffe36e;text-shadow:0 0 4px #000}
.lcell .wm{position:absolute;top:1px;left:3px;font-size:11px;font-weight:900;font-family:var(--fd);color:#fff;background:#d02a4a;border-radius:6px;padding:0 4px}
.fs-banner{text-align:center;font-family:var(--fh);font-size:20px;letter-spacing:3px;padding:4px;border-radius:8px;margin-bottom:6px}
.slot-info{display:flex;gap:8px;justify-content:center;flex-wrap:wrap;margin-top:8px}

/* ---------- SPORTS ---------- */
.sports-hero{background:linear-gradient(120deg,#16295a,#0d1a3a);padding:16px 20px;border-bottom:1px solid var(--border);flex-shrink:0}
.sports-hero h2{font-family:var(--fh);font-size:26px;color:#fff;letter-spacing:2px;font-weight:400}
.sport-tabs{display:flex;gap:6px;padding:9px 14px;overflow-x:auto;background:var(--bg2);border-bottom:1px solid var(--border);flex-shrink:0}
.sport-tab{display:flex;align-items:center;gap:5px;padding:6px 14px;border-radius:16px;font-size:12px;font-weight:700;cursor:pointer;white-space:nowrap;font-family:var(--fu);border:1px solid var(--border);color:var(--txt2)}
.sport-tab:hover{color:var(--txt)}
.sport-tab.active{background:var(--acc);border-color:var(--acc);color:#1a1100}
.sports-layout{display:flex;flex:1;min-height:0}
.sports-main{flex:1;overflow-y:auto;padding:14px}
.match-card{background:var(--bg3);border:1px solid var(--border);border-radius:12px;padding:12px;margin-bottom:10px}
.match-card.done{opacity:.85}
.match-league{font-size:10px;color:var(--txt2);font-family:var(--fu);font-weight:700;letter-spacing:.5px;margin-bottom:8px;display:flex;align-items:center;gap:6px}
.match-live-pill{background:#ff446622;color:var(--red);font-size:8px;padding:2px 6px;border-radius:5px;font-weight:700}
.match-teams{display:flex;align-items:center;justify-content:space-between;gap:8px}
.match-team{display:flex;flex-direction:column;align-items:center;gap:3px;flex:1;min-width:0}
.team-badge{width:34px;height:34px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:16px;font-weight:900;font-family:var(--fh);color:#fff}
.team-name{font-size:12px;font-weight:700;color:#fff;text-align:center;font-family:var(--fu)}
.team-score{font-family:var(--fd);font-size:20px;font-weight:900;color:var(--acc)}
.match-mid{display:flex;flex-direction:column;align-items:center;gap:2px}
.match-vs{font-family:var(--fd);font-size:11px;color:var(--txt2)}
.match-time{font-size:10px;color:var(--txt2);font-family:var(--fu)}
.match-odds{display:flex;gap:6px;margin-top:10px}
.odd-btn{flex:1;background:var(--bg4);border:1px solid var(--border);border-radius:8px;padding:7px 4px;text-align:center;cursor:pointer;transition:all .15s;color:var(--txt)}
.odd-btn:hover{border-color:var(--acc)}
.odd-btn.sel{border-color:var(--acc);background:#ffb40018}
.odd-btn.sel .odd-val{color:var(--acc)}
.odd-label{font-size:9px;color:var(--txt2);font-family:var(--fu);font-weight:700;text-transform:uppercase}
.odd-val{font-family:var(--fd);font-size:13px;font-weight:700;color:#fff;margin-top:1px}
.odd-btn.won{border-color:var(--g);background:#22d37a18}
.odd-btn.lost{opacity:.45}
.bet-slip{background:var(--bg2);border-left:1px solid var(--border);width:250px;flex-shrink:0;padding:12px;overflow-y:auto;display:flex;flex-direction:column;gap:8px}
.bet-slip h4{font-family:var(--fh);font-size:18px;letter-spacing:2px;color:var(--acc);font-weight:400}
.slip-empty{color:var(--txt2);font-size:11px;text-align:center;margin-top:20px;font-family:var(--fu)}
.bsi{background:var(--bg3);border:1px solid var(--border);border-radius:8px;padding:8px;position:relative}
.bsi-teams{font-size:11px;font-weight:600;color:#fff;font-family:var(--fu);padding-right:48px}
.bsi-pick{font-size:10px;color:var(--acc)}
.bsi-odd{font-family:var(--fd);font-size:12px;font-weight:700;color:var(--gold);position:absolute;top:8px;right:26px}
.bsi-rm{position:absolute;top:6px;right:6px;background:none;border:none;color:var(--txt2);cursor:pointer;font-size:12px}
.bsi-rm:hover{color:var(--red)}
.tot{display:flex;justify-content:space-between;font-size:11px;color:var(--txt2);font-family:var(--fu)}
.tot b{color:var(--acc);font-family:var(--fd)}
.my-bets .b{background:var(--bg3);border:1px solid var(--border);border-radius:8px;padding:8px;margin-bottom:6px;font-size:11px}

/* ---------- PROFILE / PROMOS / SETTINGS ---------- */
.prof-hdr{display:flex;align-items:center;gap:16px;background:var(--bg3);border:1px solid var(--border);border-radius:12px;padding:18px;margin-bottom:14px}
.prof-av{width:62px;height:62px;border-radius:50%;background:linear-gradient(135deg,var(--acc),var(--acc2));display:flex;align-items:center;justify-content:center;font-family:var(--fh);font-size:26px;color:#1a1100;flex-shrink:0}
.prof-hdr h2{font-family:var(--fh);font-size:24px;color:#fff;letter-spacing:1px;font-weight:400}
.prof-level{display:inline-flex;align-items:center;gap:5px;background:#ffb40018;border:1px solid var(--acc);border-radius:16px;padding:2px 10px;font-size:11px;color:var(--acc);font-family:var(--fu);font-weight:700;margin-top:6px}
.vip-bar{height:6px;background:var(--bg);border-radius:3px;margin-top:8px;overflow:hidden;width:220px}
.vip-bar i{display:block;height:100%;background:linear-gradient(90deg,var(--acc),var(--acc2))}
.stat-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:14px}
.stat-card{background:var(--bg3);border:1px solid var(--border);border-radius:10px;padding:12px}
.stat-val{font-family:var(--fd);font-size:18px;font-weight:700;color:var(--g)}
.stat-val.red{color:var(--red)}.stat-val.gold{color:var(--gold)}.stat-val.w{color:#fff}
.stat-lbl{font-size:10px;color:var(--txt2);margin-top:2px;font-family:var(--fu);font-weight:700;text-transform:uppercase;letter-spacing:.5px}
.panel{background:var(--bg3);border:1px solid var(--border);border-radius:12px;padding:14px;margin-bottom:12px}
.panel h3{font-family:var(--fh);font-size:18px;color:#fff;margin-bottom:10px;letter-spacing:1.5px;font-weight:400}
.hist-row{display:flex;align-items:center;justify-content:space-between;padding:6px 0;border-bottom:1px solid var(--border);font-size:12px;gap:10px}
.hist-row:last-child{border-bottom:none}
.hist-game{color:var(--txt);font-family:var(--fu);font-weight:700}
.hist-time{color:var(--txt2);font-size:10px}
.hist-amt{font-family:var(--fd);font-weight:700;font-size:12px}
.hist-amt.win{color:var(--g)}.hist-amt.lose{color:var(--red)}
.promo-card{background:var(--bg3);border:1px solid var(--border);border-radius:12px;padding:16px;margin-bottom:10px;display:flex;align-items:center;gap:14px}
.promo-icon{width:46px;height:46px;flex-shrink:0;background:var(--bg4);border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:24px}
.promo-info{flex:1}
.promo-title{font-family:var(--fh);font-size:18px;color:#fff;letter-spacing:1px}
.promo-desc{font-size:11px;color:var(--txt3);line-height:1.5}
.promo-code{background:var(--bg4);border:1px dashed var(--acc);border-radius:6px;padding:6px 11px;font-family:var(--fd);font-size:12px;color:var(--acc);letter-spacing:2px;cursor:pointer;flex-shrink:0}
.promo-row{display:flex;gap:8px}
.promo-in,.f-in{background:var(--bg);border:1px solid var(--border2);border-radius:7px;padding:9px 11px;color:#fff;font-size:13px;flex:1;outline:none;min-width:0}
.promo-in:focus,.f-in:focus{border-color:var(--acc)}
.settings-row{display:flex;align-items:center;justify-content:space-between;padding:10px 0;border-bottom:1px solid var(--border);gap:14px;flex-wrap:wrap}
.settings-row:last-child{border-bottom:none}
.settings-lbl{font-size:13px;color:var(--txt);font-family:var(--fu);font-weight:700;min-width:160px}
.settings-sub{font-size:10px;color:var(--txt2);font-weight:500}
.theme-dot{width:26px;height:26px;border-radius:50%;border:2px solid transparent;cursor:pointer}
.theme-dot.on{border-color:#fff}
select.f-in{flex:none}

/* ---------- AUTH ---------- */
.auth-tabs{display:flex;margin-bottom:16px;border-bottom:1px solid var(--border)}
.auth-tab{flex:1;padding:10px;text-align:center;cursor:pointer;font-family:var(--fu);font-weight:700;color:var(--txt2);border-bottom:2px solid transparent;margin-bottom:-1px}
.auth-tab.active{color:var(--acc);border-bottom-color:var(--acc)}
.auth-form{display:flex;flex-direction:column;gap:9px}
.toast{position:fixed;bottom:22px;left:50%;transform:translateX(-50%);background:linear-gradient(135deg,var(--acc),var(--acc2));color:#1a1100;padding:9px 20px;border-radius:24px;font-size:14px;z-index:500;display:none;white-space:nowrap;font-family:var(--fh);letter-spacing:1px;box-shadow:0 4px 20px rgba(255,180,0,.3);max-width:92vw;overflow:hidden;text-overflow:ellipsis}
.toast.show{display:block;animation:toastUp 2.6s ease forwards}
.toast.lose{background:linear-gradient(135deg,var(--red),#cc2244);color:#fff}
@keyframes toastUp{0%{opacity:0;bottom:8px}12%{opacity:1;bottom:22px}80%{opacity:1;bottom:22px}100%{opacity:0;bottom:30px}}
::-webkit-scrollbar{width:6px;height:6px}::-webkit-scrollbar-track{background:var(--bg2)}::-webkit-scrollbar-thumb{background:var(--border2);border-radius:3px}

/* ---------- AVIATOR ---------- */
.av-over{position:fixed;inset:0;z-index:400;background:#03060d;display:flex;flex-direction:column}
.av-top{display:flex;align-items:center;gap:12px;padding:10px 16px;background:#070d1a;border-bottom:1px solid #14223c}
.av-top .t{font-family:var(--fh);font-size:24px;color:#ff3355;letter-spacing:4px}
.av-hist{display:flex;gap:6px;flex:1;overflow:hidden;align-items:center}
.av-chart{flex:1;position:relative;min-height:0}
.av-chart canvas{position:absolute;inset:0;width:100%;height:100%}
.av-mid{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;pointer-events:none}
.av-bots{display:flex;gap:10px;padding:10px;background:#070d1a;border-top:1px solid #14223c;flex-wrap:wrap}
.av-panel{flex:1;min-width:250px;background:#0b1424;border:1px solid #14223c;border-radius:12px;padding:12px;display:flex;flex-direction:column;gap:8px}
.av-feed{max-height:130px;overflow-y:auto;flex:1}

@media(max-width:1100px){.live-panel{display:none}.hero-grid{grid-template-columns:1fr}.hero-side{flex-direction:row}.hero-side>*{flex:1}.gm{grid-template-columns:260px minmax(0,1fr)}}
@media(max-width:860px){.sidebar{display:none}.hdr{gap:8px;padding:0 8px}.search-wrap,.logo-sub{display:none}.hn{padding:0 10px;font-size:12px}.bet-slip{display:none}.slide .art{font-size:70px}.slide h2{font-size:30px}
  .gm{grid-template-columns:1fr}.gm-ctrl{border-right:none;border-bottom:1px solid var(--border)}.stat-grid{grid-template-columns:repeat(2,1fr)}.sports-layout{flex-direction:column}}
@media(max-width:560px){.hero-side{flex-direction:column}.rou-board{grid-template-columns:30px repeat(12,1fr) 30px}.rc{height:30px;font-size:10px}.big-num{font-size:56px}.pc{width:46px;height:66px;font-size:16px}}

/* ---------- bet areas (table games) ---------- */
.areas{display:grid;gap:8px;width:100%;max-width:700px}
.area{position:relative;background:var(--bg4);border:2px solid var(--border2);border-radius:12px;padding:12px 6px;text-align:center;cursor:pointer;font-family:var(--fu);font-weight:700;color:#fff;user-select:none;transition:.12s}
.area:hover{border-color:var(--acc);transform:translateY(-1px)}
.area .o{font-size:10px;color:var(--txt2);margin-top:2px}
.area.sm{padding:8px 3px;font-size:12px;border-radius:8px}
.area.win{border-color:var(--g);background:#22d37a22}
.area.p{background:#12306a}.area.b{background:#5a1220}.area.t{background:#0f4a28}
.road{display:flex;gap:4px;flex-wrap:wrap;justify-content:center;margin-top:10px;max-width:640px}
.road i{width:20px;height:20px;border-radius:50%;font-size:10px;font-style:normal;font-weight:800;color:#fff;display:flex;align-items:center;justify-content:center;font-family:var(--fd)}
.road .P{background:#2a6cd6}.road .B{background:#d02a4a}.road .T{background:#1a9a52}
.hand-box{display:inline-block;margin:0 6px;padding:6px 10px;border-radius:12px;border:2px solid transparent}
.hand-box.act{border-color:var(--acc);background:#ffffff10}
