  renderSlip() {
    const it = $('#slip-items'), ft = $('#slip-footer');
    if (!this.slip.length) { it.innerHTML = '<div class="slip-empty">Select odds to add picks</div>'; ft.style.display = 'none'; return; }
    it.innerHTML = this.slip.map((p, i) => `<div class="bsi"><div class="bsi-odd">${p.odd.toFixed(2)}</div><div class="bsi-teams">${esc(p.teams)}</div><div class="bsi-pick">${esc(p.pick)}</div><button class="bsi-rm" onclick="Sports.rm(${i})">✕</button></div>`).join('');
    ft.style.display = 'flex'; this.updateSlip();
  },
  rm(i) { this.slip.splice(i, 1); this.render(); this.renderSlip(); },
  odds() { return this.mode === 'acca' ? this.slip.reduce((a, p) => a * p.odd, 1) : null; },
  updateSlip() {
    const st = parseFloat($('#slip-stake').value) || 0, n = this.slip.length; let total, ret;
    if (this.mode === 'acca') { total = st; ret = st * this.odds(); $('#slip-odds').textContent = this.odds().toFixed(2); }
    else { total = st * n; ret = this.slip.reduce((a, p) => a + st * p.odd, 0); $('#slip-odds').textContent = n > 1 ? n + ' singles' : (this.slip[0] ? this.slip[0].odd.toFixed(2) : '1.00'); }
    $('#slip-total').textContent = fmt(total); $('#slip-pwin').textContent = fmt(ret);
  },
  async place() {
    if (!this.slip.length) return; const st = parseFloat($('#slip-stake').value) || 0; if (!(st > 0)) return toast('Enter a stake', true);
    const legs = this.slip.slice(); const acca = this.mode === 'acca' && legs.length > 1; const total = acca ? st : st * legs.length; if (!App.take(total)) return;
    const bet = { id: ++this.bid, acca, st, legs, total, state: 'pending' }; this.bets.unshift(bet); this.slip = []; this.render(); this.renderSlip(); this.renderBets(); toast('Bet placed — settling…');
    await sleep(Settings.v.quick ? 300 : 1800);
    legs.forEach(l => { const m = this.data[l.sport][l.mi]; l.res = CM.sportsOutcome(m.o); l.won = l.res === l.oi; });
    let pay = 0; if (acca) pay = legs.every(l => l.won) ? rd(st * legs.reduce((a, l) => a * l.odd, 1)) : 0; else pay = rd(legs.reduce((a, l) => a + (l.won ? st * l.odd : 0), 0));
    bet.state = 'done'; bet.pay = pay; App.pay('Sports', total, pay); this.renderBets(); toast(pay > 0 ? 'Bet won! +' + fmt(pay) : 'Bet lost', pay <= 0);
  },
  renderBets() {
    const e = $('#my-bets'); if (!this.bets.length) { e.innerHTML = '<div class="hint">No open bets.</div>'; return; }
    e.innerHTML = this.bets.slice(0, 8).map(b => `<div class="b"><div style="display:flex;justify-content:space-between"><b>${b.acca ? 'Accumulator ×' + b.legs.length : b.legs.length > 1 ? b.legs.length + ' singles' : 'Single'}</b><span style="color:${b.state === 'pending' ? 'var(--gold)' : b.pay > 0 ? 'var(--g)' : 'var(--red)'}">${b.state === 'pending' ? 'settling…' : b.pay > 0 ? '+' + fmt(b.pay) : 'lost'}</span></div>${b.legs.map(l => `<div class="hint" style="font-size:10px">${l.won === undefined ? '•' : l.won ? '✅' : '❌'} ${esc(l.teams)} — ${esc(l.pick)} @ ${l.odd.toFixed(2)}</div>`).join('')}<div class="hint">stake ${fmt(b.total)}</div></div>`).join('');
  }
};

/* =====================================================================
   BOOT
   ===================================================================== */
(function boot() {
  Settings.apply(); App.load(); Settings.syncUI(); Auth.ui();
  const order = ['crash', 'aviator', 'dice', 'limbo', 'mines', 'plinko', 'keno', 'wof', 'hilo', 'towers', 'coinflip', 'diamonds', 'slots_candy', 'slots_olympus', 'slots_fish', 'slots_egypt', 'slots_wolf', 'slots_aztec', 'blackjack', 'roulette', 'baccarat', 'dragontigger', 'threecard', 'poker', 'videopoker', 'sic_bo', 'scratchcard', 'hotcold'];
  Games.list.sort((a, b) => order.indexOf(a.id) - order.indexOf(b.id));
  Games.render(); Sports.init(); Banner.init(); Settings.startSession();
  $$('.stake-btn').forEach(b => b.classList.toggle('active', b.dataset.s === App.stake));
  App.updateBal(); App.renderProfile(); Nav.go('home', 'all');
  for (let i = 0; i < 8; i++) Live.tick(); setInterval(() => Live.tick(), 2600);
  let jp = 1284930; setInterval(() => { jp += Math.floor(CM.rnd() * 40); $('#jackpot').textContent = Settings.v.cur + jp.toLocaleString('en-US'); }, 1500);
  window.addEventListener('beforeunload', () => { try { App.save(); } catch (e) {} });
})();

</script>
