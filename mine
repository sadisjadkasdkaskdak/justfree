<!DOCTYPE html>
<html lang="en" class="h-full select-none">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Minesweeper HTML5 Canvas Transcendant</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=Inter:wght@400;600;700;800&family=VT323&display=swap');

        /* Theme CSS Custom Variables */
        :root {
            --bg-main: #0b0f19;
            --bg-card: #151d2a;
            --border-color: #2a364f;
            --lcd-bg: #030712;
            --lcd-text: #ef4444;
            --font-lcd: 'Share Tech Mono', monospace;
            
            /* Canvas Theme Colors */
            --c-cell-unrevealed: #273549;
            --c-cell-border: #3b4d66;
            --c-cell-revealed: #0e1626;
            --c-cell-revealed-border: #1a2538;
            --c-grid-bg: #060a12;
            --c-text-light: #f8fafc;
        }

        .theme-retro {
            --bg-main: #008080;
            --bg-card: #c0c0c0;
            --border-color: #808080;
            --lcd-bg: #000000;
            --lcd-text: #ff0000;
            --font-lcd: 'VT323', monospace;

            --c-cell-unrevealed: #c0c0c0;
            --c-cell-border: #ffffff;
            --c-cell-revealed: #c0c0c0;
            --c-cell-revealed-border: #808080;
            --c-grid-bg: #808080;
            --c-text-light: #000000;
        }

        .theme-neon {
            --bg-main: #060112;
            --bg-card: #12042b;
            --border-color: #00f3ff;
            --lcd-bg: #020008;
            --lcd-text: #00f3ff;
            --font-lcd: 'Share Tech Mono', monospace;

            --c-cell-unrevealed: #220847;
            --c-cell-border: #00f3ff;
            --c-cell-revealed: #090117;
            --c-cell-revealed-border: #ff0077;
            --c-grid-bg: #020008;
            --c-text-light: #00f3ff;
        }

        body {
            background-color: var(--bg-main);
            color: var(--c-text-light);
            font-family: 'Inter', sans-serif;
            touch-action: none;
            overflow: hidden;
        }

        .game-card {
            background-color: var(--bg-card);
            border-color: var(--border-color);
        }

        /* LCD Display Styling */
        .lcd-display {
            font-family: var(--font-lcd);
            background-color: var(--lcd-bg);
            color: var(--lcd-text);
            text-shadow: 0 0 10px var(--lcd-text);
            letter-spacing: 2px;
        }

        /* Retro Bevel Borders for Retro Theme */
        .theme-retro .retro-bevel {
            border-style: solid;
            border-width: 3px;
            border-color: #ffffff #808080 #808080 #ffffff;
        }
        .theme-retro .retro-inset {
            border-style: solid;
            border-width: 2px;
            border-color: #808080 #ffffff #ffffff #808080;
        }

        /* Canvas Cursor Modes */
        canvas {
            cursor: pointer;
            touch-action: none;
        }
        canvas.panning {
            cursor: grabbing !important;
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar { width: 8px; height: 8px; }
        ::-webkit-scrollbar-track { background: rgba(0, 0, 0, 0.2); }
        ::-webkit-scrollbar-thumb { background: rgba(255, 255, 255, 0.2); border-radius: 4px; }
    </style>
</head>
<body class="h-full flex flex-col justify-between antialiased">

    <!-- Header Navbar -->
    <header class="bg-slate-900/90 backdrop-blur border-b border-slate-800 sticky top-0 z-20">
        <div class="max-w-7xl mx-auto px-3 py-2.5 flex flex-wrap items-center justify-between gap-2">
            
            <!-- Title -->
            <div class="flex items-center gap-2">
                <span class="text-2xl">💣</span>
                <div>
                    <h1 class="text-lg font-extrabold text-white tracking-wide flex items-center gap-1.5 leading-none">
                        MINESWEEPER <span class="text-[10px] px-1.5 py-0.5 rounded bg-red-600 text-white font-bold uppercase tracking-wider">Canvas 2D</span>
                    </h1>
                </div>
            </div>

            <!-- Toolbar Controls -->
            <div class="flex flex-wrap items-center gap-2">
                <!-- Preset Dropdown -->
                <select id="presetSelect" class="bg-slate-800 border border-slate-700 text-slate-200 text-xs sm:text-sm rounded-lg px-2.5 py-1.5 font-medium focus:ring-2 focus:ring-blue-500 focus:outline-none">
