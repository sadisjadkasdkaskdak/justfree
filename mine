        <div class="bg-slate-900 border border-slate-700 rounded-2xl p-6 max-w-xs w-full shadow-2xl">
            <h3 class="text-lg font-bold text-white mb-4 flex items-center gap-2">⚙️ Custom Grid Settings</h3>
            <div class="space-y-3.5 text-sm">
                <div>
                    <label class="block text-slate-300 mb-1 font-semibold">Rows (5 - 100)</label>
                    <input type="number" id="inputRows" min="5" max="100" value="20" class="w-full bg-slate-800 border border-slate-700 rounded-lg px-3 py-2 text-white focus:outline-none focus:ring-2 focus:ring-blue-500">
