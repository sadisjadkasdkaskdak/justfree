                    <option value="intermediate">Intermediate (16x16, 40 Mines)</option>
                    <option value="expert">Expert (30x16, 99 Mines)</option>
                    <option value="transcendant" selected>⚡ Transcendant (100x100, 1800 Mines)</option>
                    <option value="custom">⚙️ Custom...</option>
                </select>

                <!-- Theme Selector -->
                <select id="themeSelect" class="bg-slate-800 border border-slate-700 text-slate-200 text-xs sm:text-sm rounded-lg px-2.5 py-1.5 font-medium focus:ring-2 focus:ring-blue-500 focus:outline-none">
                    <option value="dark">🌙 Dark</option>
                    <option value="retro">🖥️ Retro 95</option>
                    <option value="neon">⚡ Cyber Neon</option>
                </select>

                <!-- High Scores Button -->
                <button id="btnStats" class="bg-slate-800 hover:bg-slate-700 text-slate-200 px-2.5 py-1.5 rounded-lg text-xs font-semibold border border-slate-700 transition flex items-center gap-1">
                    🏆 <span class="hidden sm:inline">Scores</span>
