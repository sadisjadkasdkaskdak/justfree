    <!-- Main Game Area -->
    <main class="flex-grow flex flex-col items-center justify-center p-2 sm:p-4 overflow-hidden relative">
        
        <!-- Game Container Frame -->
        <div class="game-card border-2 rounded-2xl p-3 sm:p-5 shadow-2xl w-full max-w-6xl flex flex-col items-center retro-bevel transition-all">
            
            <!-- LCD Counter & Reset Header -->
            <div class="w-full bg-slate-950/80 rounded-xl p-2.5 mb-3 flex items-center justify-between border border-slate-800 shadow-inner retro-inset">
                
                <!-- Mine Counter -->
                <div class="flex flex-col items-center">
                    <span class="text-[9px] text-slate-400 font-bold uppercase tracking-wider mb-0.5">MINES</span>
                    <div id="mineCounter" class="lcd-display text-2xl sm:text-3xl font-bold px-2.5 py-0.5 rounded border border-red-950/40 min-w-[75px] text-center">
                        1800
                    </div>
                </div>

                <!-- Smiley Reset Button -->
                <button id="btnReset" class="w-11 h-11 bg-slate-700 hover:bg-slate-600 border-2 border-slate-500 active:border-slate-400 rounded-full flex items-center justify-center text-2xl shadow-md transform active:scale-95 transition cursor-pointer" title="Reset Game">
                    <span id="smileyIcon">😊</span>
                </button>

                <!-- Timer Counter -->
                <div class="flex flex-col items-center">
                    <span class="text-[9px] text-slate-400 font-bold uppercase tracking-wider mb-0.5">TIME</span>
                    <div id="timerDisplay" class="lcd-display text-2xl sm:text-3xl font-bold px-2.5 py-0.5 rounded border border-red-950/40 min-w-[75px] text-center">
                        0000
                    </div>
                </div>
            </div>

            <!-- Viewport Control Bar -->
            <div class="w-full flex flex-wrap items-center justify-between gap-2 mb-2 bg-slate-900/60 p-2 rounded-xl border border-slate-800 text-xs">
                
                <!-- Mobile Dig / Flag / Pan Tools -->
                <div class="flex items-center gap-1.5">
                    <button id="btnToolToggle" class="bg-slate-800 hover:bg-slate-700 border border-slate-700 px-2.5 py-1 rounded-lg font-bold flex items-center gap-1">
                        <span>Mode:</span>
                        <span id="toolStatus" class="px-2 py-0.5 rounded bg-blue-600 text-white">⛏️ DIG</span>
                    </button>
                    <button id="btnPanToggle" class="bg-slate-800 hover:bg-slate-700 border border-slate-700 text-slate-300 px-2.5 py-1 rounded-lg font-medium">
                        <span id="panStatus">🖐️ Pan: Off</span>
                    </button>
                </div>

                <!-- Zoom Controls -->
                <div class="flex items-center gap-1">
                    <span class="text-slate-400 font-medium mr-1 hidden sm:inline">Zoom:</span>
                    <button id="btnZoomOut" class="bg-slate-800 hover:bg-slate-700 border border-slate-700 text-slate-200 px-2.5 py-1 rounded-lg font-bold" title="Zoom Out">-</button>
                    <span id="zoomLabel" class="font-mono text-slate-300 px-1 min-w-[42px] text-center font-bold">100%</span>
                    <button id="btnZoomIn" class="bg-slate-800 hover:bg-slate-700 border border-slate-700 text-slate-200 px-2.5 py-1 rounded-lg font-bold" title="Zoom In">+</button>
                    <button id="btnZoomFit" class="bg-blue-900/60 hover:bg-blue-800 text-blue-200 border border-blue-700 px-2 py-1 rounded-lg font-semibold ml-1">Fit</button>
                    <button id="btnZoomReset" class="bg-slate-800 hover:bg-slate-700 border border-slate-700 text-slate-200 px-2 py-1 rounded-lg font-semibold">1:1</button>
                </div>
            </div>

            <!-- Canvas Viewport Box -->
            <div id="canvasViewport" class="w-full h-[58vh] min-h-[360px] rounded-xl border-2 border-slate-800 bg-slate-950 relative overflow-hidden flex items-center justify-center shadow-inner">
                <canvas id="gameCanvas" class="block w-full h-full"></canvas>
            </div>

            <!-- Bottom Keyboard/Mouse Helpers -->
            <div class="mt-2 text-[11px] text-slate-400 text-center flex flex-wrap justify-center gap-x-4 gap-y-1">
                <span>🖱️ <strong>Click:</strong> Dig</span>
                <span>🚩 <strong>Right-Click / Hold:</strong> Flag</span>
                <span>⚡ <strong>Number Click:</strong> Chord</span>
                <span>🖐️ <strong>Drag / Scroll:</strong> Pan & Zoom</span>
            </div>
        </div>
    </main>

    <!-- Custom Difficulty Modal -->
